{
  "name": "launchpad",
  "version": "1.1.0",
  "description": "A keyboard-first native macOS launcher",
  "stacks": {
    "type": "native"
  },
  "devDependencies": {
    "@buddysh/buddy": "^0.11.13",
    "@stacksjs/buddy": "0.75.334",
    "@stacksjs/types": "0.75.334",
    "better-dx": "^0.2.38"
  },
  "dependencies": {
    "@stacksjs/desktop": "0.2.751",
    "@stacksjs/github": "0.75.323",
    "@stacksjs/image": "0.75.334",
    "@stacksjs/orm": "0.75.324",
    "@stacksjs/stx": "0.2.727",
    "@stacksjs/ts-svg": "0.1.7",
    "@stacksjs/validation": "0.75.323",
    "ts-images": "0.2.32",
    "ts-pantry": "0.11.144"
  },
  "scripts": {
    "dev": "./buddy dev",
    "build": "bun run generate:brand && ./buddy build",
    "build:site": "bun run generate:brand && ./buddy generate:images --social && ./buddy build --site",
    "generate:brand": "bun scripts/generate-brand.ts",
    "package": "bun run generate:brand && ./buddy package",
    "release:patch": "./buddy release --bump patch",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "typecheck": "./buddy typecheck",
    "test": "./buddy test",
    "test:usage-native": "bun scripts/verify-native-usage.ts"
  },
  "type": "module",
  "author": "Chris Breuer <chris@stacksjs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/launchpad.git"
  }
}
