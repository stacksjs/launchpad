<script client>
import { subscribeForUpdates, subscriptionEndpoint } from '../../functions/subscription'
const preview = state('light')
const subscriberEmail = state('')
const subscriptionBusy = state(false)
const subscriptionComplete = state(false)
const subscriptionError = state('')
async function subscribeUpdates() {
  if (subscriptionBusy() || subscriptionComplete()) return
  subscriptionBusy.set(true)
  subscriptionError.set('')
  try { await subscribeForUpdates(subscriberEmail()); subscriptionComplete.set(true) }
  catch (reason) { subscriptionError.set(reason.message || 'Could not subscribe. Please try again.') }
  finally { subscriptionBusy.set(false) }
}
</script>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Scout is a free native Mac launcher. Open apps, find clipboard text, search GitHub and install tools with Pantry, all from your keyboard.">
  <meta name="theme-color" content="#f5f8fd">
  <meta property="og:title" content="Scout | Keyboard launcher for Mac">
  <meta property="og:description" content="Your apps, links and tools. One keyboard shortcut. A free native launcher for Apple Silicon Macs.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://scout.stacksjs.com/">
  <meta property="og:image" content="https://scout.stacksjs.com/social/og.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Scout app search with the Scout logo and Command + Space shortcut.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Scout | Keyboard launcher for Mac">
  <meta name="twitter:description" content="Your apps, links and tools. One keyboard shortcut.">
  <meta name="twitter:image" content="https://scout.stacksjs.com/social/og.jpg">
  <meta name="twitter:image:alt" content="Scout app search with the Scout logo and Command + Space shortcut.">
  <link rel="canonical" href="https://scout.stacksjs.com/">
  <link rel="icon" href="/images/scout.png" type="image/png">
  <link rel="icon" href="/images/scout.svg" type="image/svg+xml" sizes="any">
  <title>Scout | Keyboard launcher for Mac</title>
</head>
<body class="m-0 antialiased text-[#142238] bg-[#f5f8fd]">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="flex gap-5 items-center justify-between mx-auto px-5 md:px-10 h-[72px] max-w-[1280px]">
    <a class="flex gap-2 items-center font-semibold text-lg tracking-tight" href="/" aria-label="Scout home">
      <img src="/images/scout.svg" width="40" height="40" alt="" class="h-10 w-10" loading="eager">
      Scout
    </a>
    <nav aria-label="Main navigation" class="flex gap-5 items-center md:gap-8 font-medium text-sm">
      <a href="#features" class="hidden sm:block text-slate-600 hover:text-slate-950">Features</a>
      <a href="#pantry" class="hidden sm:block text-slate-600 hover:text-slate-950">Pantry</a>
      <a href="https://github.com/stacksjs/launchpad" class="text-slate-600 hover:text-slate-950">GitHub <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/stacksjs/launchpad/releases/latest" class="button button-small">Download for Mac</a>
    </nav>
  </header>

  <main id="main">
    <section class="grid gap-10 grid-cols-1 items-center lg:gap-14 lg:grid-cols-[0.9fr_1.3fr] mx-auto pb-16 pt-12 px-5 md:pb-20 md:pt-20 md:px-10 max-w-[1280px]" aria-labelledby="hero-title">
      <div>
        <p class="mb-5 font-semibold text-[#215ccf] text-xs tracking-[0.16em] uppercase">Keyboard launcher for Mac</p>
        <h1 id="hero-title" class="m-0 max-w-[14ch] font-semibold leading-[1.04] text-5xl tracking-[-0.055em] md:text-6xl">Apps, files, and commands.</h1>
        <p class="mb-7 mt-6 max-w-[34ch] leading-relaxed text-lg text-slate-600">Press Command + Space to open an app, find a file, or pull up something you copied.</p>
        <a href="https://github.com/stacksjs/launchpad/releases/latest" class="button">Download for Mac <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="m-0 min-w-0">
        <div class="product-frame">
          <img :src="preview() === 'light' ? '/images/applications-light.jpg' : '/images/applications.jpg'" src="/images/applications-light.jpg" width="1440" height="900" alt="Scout's native application search with real Mac app icons" class="block h-auto w-full" fetchpriority="high">
        </div>
        <figcaption class="flex gap-4 items-center justify-between mt-5 text-slate-600 text-xs">
          <span>At home in light and dark.</span>
          <div class="inline-flex gap-1 p-1 border border-slate-300 rounded-lg" role="group" aria-label="App appearance preview">
            <button type="button" class="preview-button" :aria-pressed="preview() === 'light'" @click="preview.set('light')">Light</button>
            <button type="button" class="preview-button" :aria-pressed="preview() === 'dark'" @click="preview.set('dark')">Dark</button>
          </div>
        </figcaption>
      </figure>
    </section>

    <section class="bg-white border-slate-200 border-y" aria-label="Made for your Mac">
      <div class="grid gap-7 grid-cols-1 md:gap-10 md:grid-cols-3 mx-auto px-5 py-8 md:px-10 max-w-[1280px]">
        <div class="flex gap-4 items-center"><div class="flex gap-1 shrink-0" role="img" aria-label="Command + Space"><kbd>⌘</kbd><kbd>space</kbd></div><p class="m-0 leading-relaxed text-slate-600 text-sm">Press once. Start typing.<br><strong class="font-medium text-slate-900">Your search is already focused.</strong></p></div>
        <div class="flex gap-4 items-center"><i class="shrink-0 h-7 w-7 text-slate-600 i-f7-logo-apple" aria-hidden="true"></i><p class="m-0 leading-relaxed text-slate-600 text-sm">Free for Apple Silicon Macs.<br><strong class="font-medium text-slate-900">macOS 15 or later.</strong></p></div>
        <div class="flex gap-4 items-center"><i class="shrink-0 h-7 w-7 text-slate-600 i-f7-chevron-left-slash-chevron-right" aria-hidden="true"></i><p class="m-0 leading-relaxed text-slate-600 text-sm">Built in the open with Stacks.<br><strong class="font-medium text-slate-900">Make it yours.</strong></p></div>
      </div>
    </section>

    <section id="features" class="mx-auto px-5 py-20 md:px-10 md:py-24 max-w-[1280px]" aria-labelledby="features-title">
      <h2 id="features-title" class="m-0 max-w-[20ch] font-semibold leading-tight text-3xl tracking-[-0.035em] md:text-4xl">The things you reach for.<br>Right where you need them.</h2>
      <div class="grid gap-6 grid-cols-1 md:grid-cols-2 mt-10">
        <article class="overflow-hidden bg-[#ecf2fa] border border-slate-200 rounded-2xl">
          <div class="p-7 md:p-8"><h3 class="m-0 font-semibold text-xl tracking-tight">GitHub, without the detour.</h3><p class="mb-0 mt-3 max-w-[40ch] leading-relaxed text-base text-slate-600">Find repositories, issues and pull requests. Check assigned work, review requests and notifications with your own GitHub connection.</p></div>
          <StxImage sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1279px) 45vw, 588px" src="/images/github.jpg" width="1440" height="900" alt="Scout showing issues from the Stacks GitHub repository" class="block h-auto w-full" loading="lazy" />
        </article>
        <article class="overflow-hidden bg-white border border-slate-200 rounded-2xl">
          <div class="p-7 md:p-8"><h3 class="m-0 font-semibold text-xl tracking-tight">Copy. Find. Use again.</h3><p class="mb-0 mt-3 max-w-[40ch] leading-relaxed text-base text-slate-600">Turn on Clipboard History to revisit saved text. Preview it, copy it again, or clear it. You choose what stays.</p></div>
          <StxImage sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1279px) 45vw, 588px" src="/images/clipboard.jpg" width="1440" height="900" alt="Local Clipboard History with saved text, a preview, and retention controls" class="block h-auto w-full" loading="lazy" />
        </article>
      </div>
      <div class="grid gap-8 grid-cols-1 sm:grid-cols-3 mt-10">
        <div><h3 class="flex gap-2 items-center m-0 font-semibold text-base"><i class="h-5 w-5 text-[#215ccf] i-f7-link" aria-hidden="true"></i>Quicklinks</h3><p class="mb-0 mt-2 leading-relaxed text-slate-600 text-sm">Give your regular destinations a shortcut. Open a link as quickly as an app.</p></div>
        <div><h3 class="flex gap-2 items-center m-0 font-semibold text-base"><i class="h-5 w-5 text-[#215ccf] i-f7-doc-text" aria-hidden="true"></i>Snippets</h3><p class="mb-0 mt-2 leading-relaxed text-slate-600 text-sm">Keep the text you use often ready to find and copy.</p></div>
        <div><h3 class="flex gap-2 items-center m-0 font-semibold text-base"><i class="h-5 w-5 text-[#215ccf] i-f7-number" aria-hidden="true"></i>Calculator</h3><p class="mb-0 mt-2 leading-relaxed text-slate-600 text-sm">Type an expression in search. Get the answer without opening another app.</p></div>
      </div>
    </section>

    <section id="pantry" class="bg-[#e8f0fc] border-slate-200 border-y" aria-labelledby="pantry-title">
      <div class="grid gap-10 grid-cols-1 items-center lg:gap-16 lg:grid-cols-[1.3fr_0.8fr] mx-auto px-5 py-16 md:px-10 md:py-20 max-w-[1280px]">
        <StxImage sizes="(max-width: 1023px) calc(100vw - 40px), (max-width: 1279px) 55vw, 680px" src="/images/pantry.jpg" width="1440" height="900" alt="The Pantry catalog inside Scout with original package logos and package types" class="block h-auto w-full product-frame" loading="lazy" />
        <div><h2 id="pantry-title" class="m-0 font-semibold leading-tight text-3xl tracking-[-0.035em] md:text-4xl">Your next tool<br>is a search away.</h2><p class="mb-0 mt-5 leading-relaxed text-base text-slate-600">Browse <a href="https://pantry.dev" class="font-medium underline underline-offset-4">Pantry</a>'s catalog of apps, command line tools, libraries and fonts. Install through Scout and follow the job as it runs.</p><p class="mb-0 mt-4 leading-relaxed text-base text-slate-600">All keeps your installed tools close. Pantry shows the full catalog when you want something new.</p><div class="flex flex-wrap gap-x-6 gap-y-3 mt-6"><a href="#setup" class="font-semibold text-[#215ccf] text-sm hover:text-[#174698]">Set up Pantry <span aria-hidden="true">→</span></a><a href="https://pantry.dev" class="font-semibold text-[#215ccf] text-sm hover:text-[#174698]">Explore Pantry <span aria-hidden="true">↗</span></a></div></div>
      </div>
    </section>

    <section class="mx-auto px-5 py-20 md:px-10 md:py-24 max-w-[1280px]" aria-labelledby="local-title">
      <div class="max-w-[680px]"><h2 id="local-title" class="m-0 font-semibold leading-tight text-3xl tracking-[-0.035em] md:text-4xl">Your habits stay on your Mac.</h2><p class="mb-0 mt-5 leading-relaxed text-lg text-slate-600">See how you use Scout, from apps opened to time in the palette. Local usage data lays the groundwork for your future year in review.</p></div>
      <div class="grid gap-7 grid-cols-1 md:grid-cols-3 mt-9 pt-7 border-slate-200 border-t">
        <div><h3 class="m-0 font-semibold text-base">A useful record</h3><p class="mb-0 mt-2 leading-relaxed text-slate-600 text-sm">Launches, visible time, successful app and link opens, and Pantry installs by package type.</p></div>
        <div><h3 class="m-0 font-semibold text-base">Local by design</h3><p class="mb-0 mt-2 leading-relaxed text-slate-600 text-sm">Usage lives in the app's local database. Search queries, URLs and clipboard contents are excluded from usage records.</p></div>
        <div><h3 class="m-0 font-semibold text-base">Your controls</h3><p class="mb-0 mt-2 leading-relaxed text-slate-600 text-sm">Inspect, pause or clear usage in Settings. Clipboard History is a separate, opt-in feature.</p></div>
      </div>
    </section>

    <section id="setup" class="bg-white border-slate-200 border-t" aria-labelledby="setup-title">
      <div class="grid gap-10 grid-cols-1 md:gap-16 md:grid-cols-[0.8fr_1.2fr] mx-auto px-5 py-16 md:px-10 md:py-20 max-w-[1280px]">
        <div><h2 id="setup-title" class="m-0 font-semibold text-3xl tracking-[-0.035em]">Make yourself at home.</h2><p class="mb-0 mt-4 max-w-[34ch] leading-relaxed text-base text-slate-600">A few details before your first Command + Space.</p></div>
        <div class="min-w-0">
          <details class="faq" open><summary>How do I install Scout?</summary><div class="faq-content"><p>Download the latest signed, notarized release for Apple Silicon. Unzip the download, open the disk image, and drag Scout into Applications. With the current release of <a href="https://pantry.dev">Pantry</a>, one command installs the app:</p><pre><code>pantry install launchpad</code></pre><p>Launch it once and choose Launch at login in General settings to keep it ready in your menu bar. If another app uses Command + Space, release that shortcut in its settings first.</p></div></details>
          <details class="faq"><summary>How does Pantry installation work?</summary><div class="faq-content"><p>Install <a href="https://pantry.dev">Pantry</a> separately, then run:</p><pre><code>pantry desktop setup --yes</code></pre><p>Connect in Scout Settings with the single-use pairing code. The connection is stored in macOS Keychain. Pantry's local service handles installations.</p></div></details>
          <details class="faq"><summary>Do I need a GitHub account?</summary><div class="faq-content"><p>Public GitHub search works without signing in. Add your own access token for private repositories and personal work. Scout saves it in macOS Keychain. GitHub searches are sent to GitHub.</p></div></details>
          <details class="faq"><summary>What appearance and shortcuts are available?</summary><div class="faq-content"><p>Choose System, Light or Dark in Settings. Command + Space opens and focuses search, Command + Delete clears it, and Escape dismisses the palette. Clicking another app dismisses it too.</p></div></details>
          <details class="faq"><summary>Is Scout free?</summary><div class="faq-content"><p>Yes. Scout is free and open source under the MIT license. The current Mac download is available on GitHub.</p></div></details>
        </div>
      </div>
    </section>
    <section id="updates" class="border-slate-200 border-t" aria-labelledby="updates-title">
      <div class="grid gap-8 grid-cols-1 md:grid-cols-[0.8fr_1.2fr] mx-auto px-5 py-16 md:px-10 md:py-20 max-w-[1280px]">
        <div><h2 id="updates-title" class="m-0 font-semibold text-3xl tracking-[-0.035em]">A note when something’s new.</h2><p class="mb-0 mt-4 max-w-[36ch] leading-relaxed text-base text-slate-600">Subscribe for Scout releases and useful improvements. Unsubscribe at any time.</p></div>
        <div class="self-center min-w-0">
          <form :if="!subscriptionComplete()" method="post" :action="subscriptionEndpoint" @submit.prevent="subscribeUpdates()" aria-label="Subscribe for Scout updates">
            <label for="subscriber-email" class="block mb-3 font-medium text-slate-900 text-sm">Email address</label>
            <div class="subscription-fields"><input id="subscriber-email" x-model="subscriberEmail" type="email" name="email" autocomplete="email" inputmode="email" required maxlength="255" placeholder="you@example.com" :disabled="subscriptionBusy()" :aria-describedby="subscriptionError() ? 'subscription-error' : 'subscription-privacy'"><button type="submit" class="button" :disabled="subscriptionBusy()">{{ subscriptionBusy() ? 'Subscribing…' : 'Subscribe for updates' }}</button></div>
            <p id="subscription-privacy" class="mb-0 mt-3 leading-relaxed text-slate-600 text-xs">Only Scout updates. Your email stays with Scout. <a href="https://github.com/stacksjs/launchpad/blob/main/PRIVACY.md" class="underline">Privacy</a></p>
            <p :if="subscriptionError()" id="subscription-error" class="subscription-error" role="alert">{{ subscriptionError() }}</p>
          </form>
          <p :if="subscriptionComplete()" class="subscription-success" role="status" aria-live="polite">You’re subscribed to Scout updates. Thanks for being here.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="flex flex-col gap-5 justify-between sm:flex-row mx-auto px-5 py-8 md:px-10 max-w-[1280px] text-slate-600 text-sm">
    <div class="inline-flex gap-2 items-center">
      <a href="/" class="inline-flex gap-2 items-center font-semibold text-slate-900"><img src="/images/scout.svg" width="24" height="24" alt="" loading="lazy">Scout</a>
      <span>Built with <a href="https://stacksjs.com" class="font-medium text-slate-900">Stacks</a>.</span>
    </div>
    <nav class="flex flex-wrap gap-6" aria-label="Footer navigation"><a href="#updates">Subscribe for updates</a><a href="https://bsky.app/profile/stacksjs.com">Follow Stacks</a><a href="https://pantry.dev">Pantry</a><a href="https://github.com/stacksjs/launchpad/blob/main/PRIVACY.md">Privacy</a><a href="https://github.com/stacksjs/launchpad/issues">Issues</a><a href="https://github.com/stacksjs/launchpad/issues/new">Report an issue</a></nav>
  </footer>
</body>
