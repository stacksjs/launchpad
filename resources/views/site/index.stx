<style>
  :root { color-scheme: light; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  html { scroll-behavior: smooth; scroll-padding-top: 32px; }
  body { overflow-wrap: break-word; }
  a { text-decoration: none; }
  button, summary { font: inherit; cursor: pointer; }
  a, button, summary { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 3px solid #215ccf; outline-offset: 5px; }
  .skip-link { position: fixed; top: 8px; left: 8px; z-index: 20; padding: 12px 18px; background: white; color: #142238; border: 1px solid #8195b0; border-radius: 8px; transform: translateY(-150%); }
  .skip-link:focus { transform: translateY(0); }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 48px; padding: 12px 20px; border: 1px solid #215ccf; border-radius: 10px; background: #215ccf; color: #ffffff; font-size: 14px; font-weight: 600; white-space: nowrap; transition: background 160ms ease; }
  .subscription-fields { display: flex; gap: 10px; }
  .subscription-fields input { min-width: 0; flex: 1; padding: 12px 14px; border: 1px solid #bfd0e5; border-radius: 10px; background: white; color: #142238; font: inherit; font-size: 15px; }
  .subscription-fields input:focus-visible { outline-offset: 2px; }
  .subscription-fields button:disabled { cursor: wait; opacity: .7; }
  .subscription-error { color: #b91c1c; font-size: 14px; }
  .subscription-success { padding: 18px 20px; border: 1px solid #b8c9bf; border-radius: 10px; background: #f4f8f5; color: #24422f; font-size: 16px; line-height: 1.6; }
  @media (max-width: 540px) { .subscription-fields { flex-direction: column; } }
  .button:hover { background: #174698; }
  .button-small { min-height: 38px; padding: 9px 14px; font-size: 12px; }
  .product-frame { overflow: hidden; border: 1px solid #bfd0e5; border-radius: 14px; box-shadow: 0 16px 48px -20px #1b38644d, 0 2px 5px #1b38640c; }
  .preview-button { min-width: 48px; min-height: 28px; padding: 5px 10px; border: 0; border-radius: 5px; background: transparent; color: #4d6078; font-size: 12px; }
  .preview-button[aria-pressed="true"] { background: #fff; color: #142238; box-shadow: 0 1px 3px #14223824; }
  kbd { display: inline-flex; min-width: 30px; min-height: 34px; align-items: center; justify-content: center; padding: 4px 8px; border: 1px solid #ccd9eb; border-bottom-width: 3px; border-radius: 7px; background: #eff5fe; color: #405673; font: 13px -apple-system, BlinkMacSystemFont, sans-serif; }
  .faq { border-bottom: 1px solid #dce6f2; }
  .faq summary { padding: 21px 0; font-size: 15px; font-weight: 600; line-height: 1.5; }
  .faq-content { padding: 0 0 18px; font-size: 14px; line-height: 1.75; color: #4d6078; }
  .faq-content p { margin: 0 0 12px; }
  .faq-content a { color: #215ccf; text-decoration: underline; text-underline-offset: 3px; }
  pre { max-width: 100%; overflow-x: auto; margin: 16px 0; padding: 15px; border: 1px solid #dce6f2; border-radius: 8px; background: #eff5fe; color: #142238; font-size: 12px; }
  @media (max-width: 420px) { header nav { gap: 12px; } header nav > a:not(.button) { display: none; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition: none !important; } }
</style>
