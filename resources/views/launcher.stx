<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Launchpad</title>
</head>
<body>
<script client>
import type { NativeUpdateState } from '@stacksjs/desktop'
import pkg from '../../package.json'
import type { Result } from '../functions/search'
import { cacheResultQueries, createResultSearch, quicklinkUrl } from '../functions/search'
import { parseApplicationAliases } from '../functions/search-text'
import { historyPreference as readHistoryPreference, parsePreference } from '../functions/preferences'
import { createResultPresentation, createResultSlots, resultRowHeight, resultWindow, selectionTarget } from '../functions/result-list'
import { visibleApplicationPaths } from '../functions/application-icons'
import { calculate } from '../functions/calculator'
import { registerLauncher, configureTray, nativeAutoLaunch, nativeWindow, execute, captureClipboard, applicationIcons, clipboard, shell, windowEvents, menu, standardMenus, behavior, sources, revealInFinder, openPrivacySettings } from '../functions/native'
import { initializeLogin, setLoginEnabled } from '../functions/startup'
import { clipboardDecision, clipboardTitle } from '../functions/clipboard'
import { pairingDigits, plural } from '../functions/format'
import { actionLabelFor, composeResults, fileResults, fileTabMinimum, inlineFileMinimum, isRankable, nextCategory, secondaryActions } from '../functions/launcher-results'
import { emojiResults } from '../functions/emoji'
import { defaultSearchSettings, readSearchSettings, webEngines } from '../functions/search-settings'
import { systemCommand, systemCommandResults } from '../functions/system-commands'
import { extensionResults, parseExtension, sampleManifest } from '../functions/extensions'
import { createLatest } from '../functions/sources'
import { githubResults, restoreGitHub, connectGitHub, disconnectGitHub } from '../functions/github'
import type { GitHubView } from '../functions/github'
import { pantryResults, installedCatalog, createPackageCatalogSearch, restorePantry, pantryConnected, connectPantry, disconnectPantry, installedPantry, installPantry, pantryJobs } from '../functions/pantry'
import type { PackageCatalogEntry, DesktopInstalledPackage, DesktopInstallJob } from '../functions/pantry'
import { activityPayload, formatUsageTime, recordSuccessfulOperation } from '../functions/activity'
import type { ActivityAction, ActivitySummary } from '../functions/activity'
import { createApplicationRefresh } from '../functions/applications'

const catalog = state<PackageCatalogEntry[]>([])
const pantryInstalled = state<DesktopInstalledPackage[]>([])
const pantryReady = state(false)
const pantryRestoring = state(false)
const pantryStatus = state('Connect the Pantry CLI in Settings to install packages.')
const pantryCode = state('')
const pantryFilter = state('all')
const packageDetail = state<Result | null>(null)
const installJobs = state<DesktopInstallJob[]>([])
const installJob = derived(() => installJobs().find(job => job.domain === packageDetail()?.content) || null)
const packageAppPath = derived(() => pantryInstalled().find(item => item.name === packageDetail()?.package?.domain && item.applicationPath)?.applicationPath || '')
const packageBusy = state(false)
const installRequests: Record<string, string> = {}
let pollingJob = false
const searchSettings = state(defaultSearchSettings)
const fileItems = state<Result[]>([])
const windowItems = state<Result[]>([])
const contactItems = state<Result[]>([])
const eventItems = state<Result[]>([])
const sourceNote = state('')
const sourceLoading = state(false)
const exchangeRates = state<{ rates: Record<string, number>, updatedAt: number } | null>(null)
const ratesState = derived(() => searchSettings().currency ? { enabled: true as const, table: exchangeRates() } : { enabled: false as const })
const extensionRows = state<any[]>([])
const extensionDraft = state('')
const extensionIssues = state<string[]>([])
const extensionCommands = derived(() => extensionResults(extensionRows()))
const query = state('')
const category = state('all')
const items = state<Result[]>([])
const records = state<Record<string, any>>({})
const selected = state(0)
const visibleLimit = state(100)
const resultScrollTop = state(0)
const resultViewportHeight = state(450)
const loading = state(true)
const error = state('')
/** The privacy pane that would settle the current error, when the failure names one. */
const errorPermission = state('')
const status = state('Ready when you are')
const editor = state(false)
const aliasApplication = state<Result | null>(null)
const applicationAliases = state('')
const aliasInput = useRef('aliasInput')
const builtInApplicationAliases = derived(() => (aliasApplication()?.searchAliases || []).filter(value => value.split('.').length < 3).slice(0, 10).join(', '))
const editId = state<number | null>(null)
const title = state('')
const kind = state('quicklink')
const content = state('')
const alias = state('')
const saving = state(false)
const updateState = state<NativeUpdateState>({ currentVersion: pkg.version, phase: 'idle' })
const updateBusy = derived(() => ['checking', 'downloading', 'installing'].includes(updateState().phase))
const updateMessage = derived(() => {
  const update = updateState()
  if (update.phase === 'checking') return 'Checking for updates...'
  if (update.phase === 'available') return 'Launchpad ' + update.version + ' is available.'
  if (update.phase === 'current') return 'You are up to date.'
  if (update.phase === 'downloading') return 'Downloading update... ' + Math.round(update.percent || 0) + '%'
  if (update.phase === 'ready') return 'Launchpad ' + update.version + ' is ready to install.'
  if (update.phase === 'installing') return 'Verifying and installing update...'
  if (update.phase === 'installed') return 'Restarting Launchpad...'
  return update.error || 'Check for the latest version of Launchpad.'
})
const settings = state(false)
const settingsSection = state('general')
const settingsQuery = state('')
const settingsSections = [
  { id: 'general', title: 'General', icon: 'M9.5 3h5l.6 2.2 2 .9 2-.6 2.5 4.3-1.5 1.6v2.3l1.5 1.6-2.5 4.3-2-.6-2 .9-.6 2.1h-5l-.6-2.1-2-.9-2 .6L2 15.3l1.5-1.6v-2.3L2 9.8l2.5-4.3 2 .6 2-.9L9.5 3Z M15.5 12a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z', color: '#7d8491', description: 'Startup, keyboard shortcut and background behavior.', keywords: 'login startup shortcut menu bar' },
  { id: 'appearance', title: 'Appearance', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M12 3v18 M15 5v14 M18 7v10', color: '#625f70', description: 'Choose how Launchpad looks on your Mac.', keywords: 'theme dark light system' },
  { id: 'updates', title: 'Software Update', icon: 'M20 7v5h-5 M20 12a8 8 0 1 0-2.3 5.7 M20 12l-3-3', color: '#7d8491', description: 'Keep Launchpad up to date with verified releases.', keywords: 'version download install automatic' },
  { id: 'search', title: 'Search', icon: 'M16 10a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z M14.5 14.5 21 21', color: '#2585ed', description: 'Choose what to search and how to use your results.', keywords: 'files web currency paste permissions windows contacts calendar' },
  { id: 'clipboard', title: 'Clipboard History', icon: 'M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3 M9 2h6v4H9Z M8 11h8 M8 15h8 M8 19h5', color: '#e39928', description: 'Manage the text history stored on this Mac.', keywords: 'copy retention clear privacy' },
  { id: 'github', title: 'GitHub', icon: 'M6 3v12a4 4 0 0 0 4 4h4 M18 6v4a4 4 0 0 1-4 4H6 M9 3a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M21 3a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M20 19a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z', color: '#6556c8', description: 'Connect your account to search your repositories.', keywords: 'account token private issues pull requests' },
  { id: 'pantry', title: 'Pantry', icon: 'M3 7l9-5 9 5v10l-9 5-9-5V7Z M3 7l9 5 9-5 M12 12v10 M7.5 4.5l9 5', color: '#dd7553', description: 'Connect Pantry to install and manage your tools.', keywords: 'packages cli apps libraries fonts' },
  { id: 'extensions', title: 'Extensions', icon: 'M9 3H4v6a3 3 0 1 1 0 6v5h5a3 3 0 1 1 6 0h5v-5a3 3 0 1 1 0-6V3h-5a3 3 0 1 1-6 0Z', color: '#8b66cf', description: 'Add quicklinks and snippets to Launchpad.', keywords: 'commands manifest json' },
  { id: 'usage', title: 'Usage', icon: 'M4 20V10h4v10H4Z M10 20V4h4v16h-4Z M16 20V8h4v12h-4Z', color: '#43a96a', description: 'Review your activity, saved only on this Mac.', keywords: 'privacy activity history statistics recording' },
]
const visibleSettings = derived(() => settingsSections.filter(section => (section.title + ' ' + section.keywords).toLowerCase().includes(settingsQuery().trim().toLowerCase())))
const currentSettings = derived(() => settingsSections.find(section => section.id === settingsSection()) || settingsSections[0])
const automaticUpdatesEnabled = state(true)
async function changeAutomaticUpdates(enabled) {
  try { await preference('updates', JSON.stringify({ enabled })); automaticUpdatesEnabled.set(enabled) }
  catch (reason) { fail(reason) }
}
function chooseSettings(value) { settingsSection.set(value); clearError(); if (value === 'general') void refreshLogin(); if (value === 'updates') void refreshUpdate() }
const loginEnabled = state(false)
const loginBusy = state(false)
const loginStatus = state('Checking macOS Login Items...')
const settingsTitle = useRef('settingsTitle')
const usageEnabled = state(true)
const usageSummary = state<ActivitySummary | null>(null)
const usageIssue = state('')
const usageQueue: ReturnType<typeof activityPayload>[] = []
const usagePending = state(0)
let usageTask: Promise<void> | null = null
let usageClearing = false
const paletteVisible = state(false)
const icons = state<Record<string, string>>({})
const preferences = state<Record<string, any>>({})
const preferencesReady = state(false)
const themePreference = state('system')
const colorMode = useColorMode({ initialMode: 'system', storageKey: 'launchpad.appearance' })
const historyEnabled = state(false)
const historyDays = state(7)
const historyStatus = state('History is paused')
const githubView = state<GitHubView>('issues')
const githubScope = state('stacksjs/launchpad')
const githubViewer = state<{ login: string } | null>(null)
const githubItems = state<Result[]>([])
const githubLoading = state(false)
const githubStatus = state('Public repositories work without connecting an account.')
const tokenInput = state('')
let historyCursor = -1
let historyBusy = false
let githubEpoch = 0
let githubRequest: AbortController | null = null
const search = useRef('search')
const commandTitle = useRef('commandTitle')
const list = useRef('results')
let cleanup = () => {}
let cleanupTray = () => {}

const searchCatalog = derived(() => createPackageCatalogSearch(catalog()))
const installedPackages = derived(() => pantryResults(installedCatalog(catalog(), pantryInstalled()), items(), pantryInstalled()))
const localItems = derived(() => [...items(), ...installedPackages(), ...systemCommandResults(), ...extensionCommands()].map(item => ({ ...item, ...records()[item.key], key: item.key, id: item.id })))
const searchLocal = derived(() => createResultSearch(localItems()))
const searchPackages = derived(() => {
  const filter = pantryFilter()
  const search = createResultSearch(pantryResults(catalog(), items(), pantryInstalled(), filter, true).map(item => ({ ...item, ...records()[item.key], key: item.key, id: item.id })))
  const candidates = searchCatalog()
  return cacheResultQueries(input => input.trim() ? search(input, 'pantry', candidates(input, { kind: filter === 'all' ? undefined : filter, limit: 50000 }).map(item => 'pantry:' + item.domain)) : search('', 'pantry'))
})
const githubCommands = derived(() => githubItems().map(item => ({ ...item, ...records()[item.key], key: item.key, id: item.id })))
// Built the first time emoji are searched, not while typing anything else.
const emojiIndex = derived(() => createResultSearch(emojiResults(records())))
const searchEmoji = (input, scope) => emojiIndex()(input, scope)
const allResults = derived(() => {
  if (category() === 'pantry') return searchPackages()(query())
  if (category() === 'github') return githubCommands()
  return composeResults({ category: category(), query: query(), searchLocal: searchLocal(), searchEmoji, files: fileItems(), windows: windowItems(), contacts: contactItems(), events: eventItems(), rates: ratesState(), settings: searchSettings(), calculate })
})
const presentResults = createResultPresentation()
const results = derived(() => presentResults(allResults().slice(0, visibleLimit()), icons()))
const viewport = derived(() => resultWindow(results().length, resultScrollTop(), resultViewportHeight()), { equals: (a, b) => a.start === b.start && a.end === b.end && a.bottom === b.bottom })
const resultSlots = derived(() => {
  items(); records(); catalog(); pantryInstalled(); githubItems(); fileItems(); windowItems(); contactItems(); eventItems(); extensionRows(); searchSettings()
  return createResultSlots()
})
const renderedResults = derived(() => resultSlots()(results(), viewport().start, viewport().end))
const active = derived(() => results()[selected()])
const actionLabel = derived(() => actionLabelFor(active()?.kind))
const secondary = derived(() => secondaryActions(active()))

function scrollResults(event) {
  batch(() => {
    resultScrollTop.set(event.target.scrollTop)
    resultViewportHeight.set(event.target.clientHeight)
  })
}

// The framework's enabled option skips callbacks but keeps its interval running.
function pollWhile(callback, milliseconds, enabled) {
  const timer = useInterval(callback, milliseconds)
  effect(() => { if (enabled()) timer.resume(); else timer.pause() })
}

async function api(path, method = 'GET', body?) {
  const response = await fetch('/api/' + path, { method, cache: 'no-store', ...(body === undefined ? {} : { headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }) })
  if (!response.ok) {
    const data = await response.json().catch(() => ({}))
    throw Object.assign(new Error(data.error || 'Could not save your changes. Try again.'), { status: response.status })
  }
  return response.status === 204 ? null : (await response.json()).data
}

async function all(path) {
  const rows = []
  for (let page = 1; ; page++) {
    const part = await api(path + '?per_page=100&page=' + page)
    rows.push(...part)
    if (part.length < 100) return rows
  }
}

async function refreshCatalog() {
  packageBusy.set(true)
  try { catalog.set(await api('pantry/catalog/refresh', 'POST')); pantryStatus.set(plural(catalog().length, 'package') + ' · Catalog updated') }
  catch (reason) { pantryStatus.set(reason.message) }
  finally { packageBusy.set(false) }
}
async function connectPackages() {
  if (pantryRestoring()) return
  packageBusy.set(true)
  try { pantryInstalled.set(await connectPantry(pairingDigits(pantryCode()))); installJobs.set(await pantryJobs()); pantryCode.set(''); pantryReady.set(true); pantryStatus.set('Connected to Pantry · ' + plural(pantryInstalled().length, 'installed package')) }
  catch (reason) { pantryReady.set(pantryConnected()); pantryStatus.set(reason.message) }
  finally { packageBusy.set(false) }
}
async function refreshPackages() {
  if (pantryRestoring()) return
  pantryRestoring.set(true)
  pantryStatus.set('Checking saved Pantry connection...')
  try {
    pantryInstalled.set(await restorePantry())
    pantryReady.set(pantryConnected())
    if (pantryConnected()) installJobs.set(await pantryJobs())
    pantryStatus.set(pantryConnected() ? 'Connected to Pantry · ' + plural(pantryInstalled().length, 'installed package') : 'Connect the Pantry CLI in Settings to install packages.')
  }
  catch (reason) {
    pantryReady.set(pantryConnected())
    pantryStatus.set(['PERMISSION_DENIED', 'CANCELLED'].includes(reason.code) ? 'macOS could not unlock your saved connection. Check the saved connection to try again.' : reason.message)
  }
  finally { pantryRestoring.set(false) }
}
async function disconnectPackages() {
  try { await disconnectPantry(); pantryReady.set(false); pantryInstalled.set([]); pantryStatus.set('Pantry disconnected. Catalog search remains available.') }
  catch (reason) { pantryStatus.set(reason.message) }
}
async function openPackageApplication() {
  const item = packageDetail()
  if (!item || !packageAppPath()) return
  try {
    await execute({ ...item, kind: 'application', content: packageAppPath() }, '', duration => recordExecution({ kind: 'application', title: item.title }, duration))
  }
  catch (reason) { fail(reason) }
}
async function copySetupCommand() {
  try { await clipboard.writeText('pantry desktop setup --yes'); pantryStatus.set('Setup command copied. Run it in your terminal.') }
  catch (reason) { pantryStatus.set(reason.message || 'Could not copy the setup command.') }
}
function closePackage() { packageDetail.set(null); void nextTick(() => search.current?.focus()) }
async function startInstall() {
  const item = packageDetail()
  if (!item || packageBusy()) return
  if (!pantryReady()) { settingsSection.set('pantry'); packageDetail.set(null); openSettings(); return }
  packageBusy.set(true)
  try {
    if (!installRequests[item.content] || installJob()?.status === 'failed') installRequests[item.content] = crypto.randomUUID()
    const job = await installPantry(item.content, installRequests[item.content])
    installJobs.set([job, ...installJobs().filter(previous => previous.id !== job.id)])
    pantryStatus.set('Installation requested from Pantry')
  }
  catch (reason) { pantryStatus.set(reason.message) }
  finally { packageBusy.set(false) }
}
async function pollInstall() {
  if (!installJobs().some(job => ['queued', 'running'].includes(job.status)) || pollingJob) return
  pollingJob = true
  try {
    const previous = installJobs()
    const current = await pantryJobs()
    installJobs.set(current)
    const completed = current.filter(job => job.status === 'succeeded' && previous.some(old => old.id === job.id && ['queued', 'running'].includes(old.status)))
    if (completed.length) {
      pantryInstalled.set(await installedPantry())
      pantryStatus.set('Installed with Pantry')
      await reload()
    }
  }
  catch (reason) { pantryStatus.set(reason.message) }
  finally { pollingJob = false }
}
pollWhile(pollInstall, 1000, () => installJobs().some(job => ['queued', 'running'].includes(job.status)))

const refreshApplications = createApplicationRefresh({ load: () => api('applications'), current: items, replace: value => items.set(value), count: count => status.set(plural(count, 'application') + ' · Local commands') })
pollWhile(() => { void refreshApplications().catch(fail) }, 5000, () => paletteVisible())

const loadResultIcons = useDebounce((paths) => {
  void applicationIcons(paths).then(value => {
    if (Object.entries(value).some(([path, icon]) => icons()[path] !== icon)) icons.set({ ...icons(), ...value })
  }).catch(fail)
}, 50)
effect(() => {
  loadResultIcons.cancel()
  if (!paletteVisible() || settings() || editor() || packageDetail()) return
  const paths = visibleApplicationPaths(results(), resultScrollTop(), list.current?.clientHeight || 450)
  if (paths.length) loadResultIcons(paths)
})

async function reload() {
  loading.set(true)
  try {
    const [apps, commands, history, launches, extensions] = await Promise.all([api('applications'), all('commands'), all('clipboard-entries'), all('launch-records'), all('extensions')])
    items.set([...apps,
      ...commands.map(row => ({ key: 'command:' + row.id, id: row.id, title: row.title, subtitle: row.kind === 'snippet' ? 'Snippet · Copy text' : row.content, kind: row.kind, content: row.content, alias: row.alias })),
      ...history.reverse().map(historyResult),
    ])
    extensionRows.set(extensions)
    records.set(Object.fromEntries(launches.map(row => [row.key, { ...row, lastUsed: row.lastUsed ?? row.last_used }])))
    status.set(plural(apps.length, 'application') + ' · Local commands')
  }
  catch (reason) { error.set(reason.message) }
  finally { loading.set(false) }
}

function focusSearch() { batch(() => { query.set(''); category.set('all'); selected.set(0) }); void nextTick(() => search.current?.focus()) }
function chooseCategory(value) { batch(() => { query.set(''); category.set(value); selected.set(0) }); void nextTick(() => search.current?.focus()) }
function clearError() { batch(() => { error.set(''); errorPermission.set('') }) }
function fail(reason) { batch(() => { error.set(reason.message || String(reason)); errorPermission.set(reason.permission || '') }) }
function openSettings(checkUpdates = false) {
  settings.set(true)
  clearError()
  if (settingsSection() === 'general') {
    void refreshLogin()

  }
  if (settingsSection() === 'updates') { if (checkUpdates === true) void updateLaunchpad(); else void refreshUpdate() }
  void nativeWindow.show().then(() => nativeWindow.focus()).then(() => nextTick(() => settingsTitle.current?.focus()))
}
let updateRequest = 0
let updateRefreshing = false
async function refreshUpdate() {
  if (updateRefreshing) return
  updateRefreshing = true
  const attempt = updateRequest
  try {
    const response = await fetch('/api/updates', { cache: 'no-store' })
    if (!response.ok) throw new Error('Could not read update status.')
    const result = await response.json()
    if (attempt === updateRequest) updateState.set(result)
  }
  catch (reason) { if (attempt === updateRequest) updateState.set({ ...updateState(), phase: 'error', error: reason.message }) }
  finally { updateRefreshing = false }
}
async function updateLaunchpad(action = 'check') {
  if (updateBusy()) return
  updateRequest++
  updateState.set({ ...updateState(), phase: action === 'check' ? 'checking' : action === 'download' ? 'downloading' : 'installing', error: undefined })
  try {
    const response = await fetch('/api/updates/' + action, { method: 'POST' })
    const result = await response.json()
    updateState.set(result)
    if (!response.ok && response.status !== 409) throw new Error(result.error || 'Update request failed.')
  }
  catch (reason) { updateState.set({ ...updateState(), phase: 'error', error: reason.message }) }
}
function checkForUpdates() { settingsSection.set('updates'); openSettings(true) }
pollWhile(refreshUpdate, 500, () => paletteVisible() && settings() && settingsSection() === 'updates')
pollWhile(refreshUpdate, 60000, () => paletteVisible() && !(settings() && settingsSection() === 'updates'))
function closeSettings() { settings.set(false); void nextTick(() => search.current?.focus()) }
async function refreshLogin(initialize = false) {
  if (loginBusy()) return
  loginBusy.set(true)
  try {
    const enabled = initialize
      ? await initializeLogin(nativeAutoLaunch, Boolean(preferences().loginInitialized), () => preference('loginInitialized', 'true'))
      : await nativeAutoLaunch.isEnabled()
    loginEnabled.set(enabled)
    loginStatus.set(enabled ? 'Launchpad starts quietly in the menu bar when you sign in.' : 'Launch at login is off. If macOS needs approval, check System Settings > General > Login Items.')
  }
  catch (reason) { loginStatus.set(reason.message) }
  finally { loginBusy.set(false) }
}
async function changeLogin(enabled) {
  if (loginBusy()) return
  loginBusy.set(true)
  try {
    loginEnabled.set(await setLoginEnabled(nativeAutoLaunch, enabled))
    await preference('loginInitialized', 'true')
    loginStatus.set(loginEnabled() ? 'Launchpad starts quietly in the menu bar when you sign in.' : enabled ? 'Approve Launchpad in System Settings > General > Login Items.' : 'Launch at login is off.')
  }
  catch (reason) { loginStatus.set(reason.message) }
  finally { loginBusy.set(false) }
}
function closeEditor() { editor.set(false); aliasApplication.set(null); void nextTick(() => search.current?.focus()) }
function activate() { settings.set(false); editor.set(false); packageDetail.set(null); focusSearch(); paletteVisibility(true); void refreshApplications().catch(fail) }
function paletteVisibility(visible) { paletteVisible.set(visible); track(visible ? 'palette_opened' : 'palette_dismissed') }
async function dismissLauncher() { paletteVisibility(false); void flushUsage(); await nativeWindow.hide() }
function recordExecution(target, duration) {
  track('command_executed', target, duration)
  paletteVisibility(false)
}
async function openLink(url, kind) {
  try { await recordSuccessfulOperation(() => shell.openExternal(url), async duration => { track('link_opened', { kind }, duration); await flushUsage() }) }
  catch (reason) { fail(reason) }
}

function track(action: ActivityAction, target = { kind: 'launcher' }, durationMs = 0) {
  if (!preferencesReady() || usageClearing || (!usageEnabled() && !['palette_opened', 'palette_dismissed'].includes(action))) return
  if (usageQueue.length >= 500) { usageIssue.set('The local API is unavailable. New activity could not be queued.'); return }
  usageQueue.push(activityPayload(action, target, durationMs))
  usagePending.set(usageQueue.length)
  void flushUsage()
}
function flushUsage(): Promise<void> {
  if (usageTask) return usageTask
  if (!usageQueue.length) return Promise.resolve()
  usageTask = (async () => {
    try {
      while (usageQueue.length) {
        const event = usageQueue[0]
        try { await api('activity-events', 'POST', event) }
        catch (reason) {
          // The backend will never accept a rejected event, so it must not block the ones behind it.
          if (!(reason.status >= 400 && reason.status < 500 && ![408, 429].includes(reason.status))) throw reason
        }
        if (usageQueue[0] === event) usageQueue.shift()
        usagePending.set(usageQueue.length)
      }
      usageIssue.set('')
    }
    catch { usageIssue.set('Usage is waiting for the local API and will retry while Launchpad is running.') }
  })().finally(() => { usageTask = null })
  return usageTask
}
async function refreshUsage() {
  try { await flushUsage(); usageSummary.set(await api('activity-summary')); if (!usageQueue.length) usageIssue.set('') }
  catch (reason) { usageIssue.set(reason.message) }
}
async function usagePreference(enabled) {
  try {
    await flushUsage()
    await preference('usage', JSON.stringify({ enabled }))
    usageEnabled.set(enabled)
    if (!enabled) { usageQueue.splice(0); usagePending.set(0) }
    paletteVisibility(paletteVisible())
    await refreshUsage()
  }
  catch (reason) { fail(reason) }
}
async function clearUsage() {
  if (!await stxConfirm('Delete all locally stored usage history? Your future year review will start again.')) return
  usageClearing = true
  try { await flushUsage(); usageQueue.splice(0); usagePending.set(0); await api('activity-events', 'DELETE'); await refreshUsage() }
  catch (reason) { fail(reason) }
  finally { usageClearing = false }
}
pollWhile(flushUsage, 3000, () => preferencesReady() && usagePending() > 0)
pollWhile(refreshUsage, 15000, () => paletteVisible() && settings() && settingsSection() === 'usage')
effect(() => { if (paletteVisible() && settings() && settingsSection() === 'usage') void refreshUsage() })

function historyResult(row) {
  const source = row.sourceApp || row.source_app || ''
  return { key: 'clipboard:' + row.id, id: row.id, title: clipboardTitle(row.content), subtitle: source ? 'Clipboard · ' + source.split('.').pop() : 'Saved clipboard text', kind: 'clipboard', content: row.content }
}
async function reloadHistory() {
  const rows = await all('clipboard-entries')
  items.set([...items().filter(item => item.kind !== 'clipboard'), ...rows.reverse().map(historyResult)])
}
let preferenceTask = Promise.resolve()
function preference(key, value) {
  const save = async () => {
    const previous = preferences()[key]
    const row = await api('preferences' + (previous ? '/' + previous.id : ''), previous ? 'PATCH' : 'POST', { key, value })
    preferences.set({ ...preferences(), [key]: row })
  }
  const task = preferenceTask.then(save)
  preferenceTask = task.catch(() => {})
  return task
}
async function appearance(value) {
  try {
    await preference('appearance', value)
    themePreference.set(value)
    colorMode.set(value)
    await nativeWindow.setAppearance(value)
  }
  catch (reason) { fail(reason) }
}
async function historyPreference(enabled, days = historyDays()) {
  try {
    await preference('history', JSON.stringify({ enabled, days: Number(days) }))
    historyCursor = -1
    historyEnabled.set(enabled)
    historyDays.set(Number(days))
    historyStatus.set(enabled ? 'Recording new text locally' : 'History is paused')
  }
  catch (reason) { fail(reason) }
}
async function pollClipboard() {
  if (historyBusy || !historyEnabled()) return
  historyBusy = true
  try {
    const snapshot = await clipboard.historySnapshot(historyCursor)
    const decision = clipboardDecision(snapshot.text)
    if (decision === 'save' && snapshot.text !== items().find(item => item.kind === 'clipboard')?.content) {
      await api('clipboard-entries', 'POST', { content: snapshot.text, capturedAt: Date.now(), sourceApp: snapshot.sourceBundleId }); track('clipboard_saved', { kind: 'clipboard' })
      await reloadHistory()
    }
    historyCursor = snapshot.changeCount
    historyStatus.set(snapshot.blocked ? 'Protected clipboard content skipped' : decision === 'too-large' ? 'Text over 20,000 characters skipped' : 'Recording new text locally')
  }
  catch (reason) { historyEnabled.set(false); historyStatus.set('History stopped'); fail(reason) }
  finally { historyBusy = false }
}
async function clearHistory() {
  if (!await stxConfirm('Delete all saved clipboard history from this Mac?')) return
  try { await api('clipboard-history', 'DELETE'); await reloadHistory() }
  catch (reason) { fail(reason) }
}
async function loadPreferences() {
  const rows = await all('preferences')
  const values = Object.fromEntries(rows.map(row => [row.key, row]))
  preferences.set(values)
  const theme = values.appearance?.value || 'system'
  themePreference.set(theme)
  colorMode.set(theme)
  await nativeWindow.setAppearance(theme)
  if (values.githubScope) githubScope.set(values.githubScope.value)
  if (values.search) { searchSettings.set(readSearchSettings(values.search.value)); behavior.paste = searchSettings().paste }
  if (values.history) {
    const saved = readHistoryPreference(values.history.value)
    historyEnabled.set(saved.enabled)
    historyDays.set(saved.days)
  }
  automaticUpdatesEnabled.set(parsePreference(values.updates?.value).enabled !== false)
  if (values.usage) usageEnabled.set(parsePreference(values.usage.value).enabled === true)
  preferencesReady.set(true)
}
async function refreshGitHub() {
  const epoch = ++githubEpoch
  githubRequest?.abort()
  githubRequest = null
  githubLoading.set(false)
  if (!paletteVisible() || category() !== 'github') return
  const controller = new AbortController()
  githubRequest = controller
  githubLoading.set(true)
  githubItems.set([])
  try {
    const found = await githubResults(githubView(), query(), githubScope(), githubViewer()?.login || '', controller.signal)
    if (epoch !== githubEpoch) return
    githubItems.set(found)
    track('github_search', { kind: 'github' })
    githubStatus.set(plural(found.length, 'result') + ' · Search sent only to GitHub')
  }
  catch (reason) { if (epoch === githubEpoch) githubStatus.set(reason.message) }
  finally { if (epoch === githubEpoch) githubLoading.set(false) }
}
const searchGitHub = useDebounce(refreshGitHub, 400)
effect(() => {
  category(); githubView(); query(); githubScope(); githubViewer(); paletteVisible()
  ++githubEpoch
  githubRequest?.abort()
  githubLoading.set(false)
  searchGitHub.cancel()
  if (paletteVisible() && category() === 'github') searchGitHub()
})
onDestroy(() => githubRequest?.abort())
async function connectAccount() {
  saving.set(true)
  try { githubViewer.set(await connectGitHub(tokenInput())); tokenInput.set(''); clearError(); void refreshGitHub() }
  catch (reason) { fail(reason) }
  finally { saving.set(false) }
}
async function disconnectAccount() {
  try { await disconnectGitHub(); githubViewer.set(null); githubItems.set([]) }
  catch (reason) { fail(reason) }
}
async function saveScope() {
  try {
    const scope = githubScope().trim()
    if (scope && !/^[\w.-]+\/[\w.-]+$/.test(scope)) throw new Error('Use owner/repository, or leave the scope empty.')
    await preference('githubScope', scope)
    void refreshGitHub()
  }
  catch (reason) { fail(reason) }
}
pollWhile(pollClipboard, 800, () => preferencesReady() && historyEnabled())

// Live sources: files from Spotlight's index, windows, contacts and events from the apps that own them.
// Only the newest request is applied. Nothing from these sources is stored by Launchpad.
// Plain flags, not signals: reading a signal here would make the effects below depend on their own results.
let windowsShown = false
let eventsShown = false
let eventsAt = 0
function sourceFailure(reason) { sourceNote.set(reason.message || String(reason)) }
const loadFiles = createLatest(async (text, signal) => {
  const response = await fetch('/api/files?q=' + encodeURIComponent(text), { signal, cache: 'no-store' })
  if (!response.ok) throw new Error('File search is unavailable.')
  return await response.json()
}, {
  start: () => sourceLoading.set(true),
  result: (body) => {
    fileItems.set(fileResults(body.data))
    sourceNote.set(!body.enabled ? 'File search is off. Turn it on in Settings > Search.' : !body.available ? 'File search is not available in this build of Launchpad.' : '')
  },
  error: (reason) => { fileItems.set([]); sourceFailure(reason) },
  done: () => sourceLoading.set(false),
})
const loadContacts = createLatest((text) => sources.contacts(text), {
  start: () => sourceLoading.set(true),
  result: (found) => { contactItems.set(found); sourceNote.set(found.length ? '' : 'No contacts match.') },
  error: (reason) => { contactItems.set([]); sourceFailure(reason) },
  done: () => sourceLoading.set(false),
}, { serial: true })
const loadWindows = createLatest(() => sources.windows(), {
  start: () => { if (!windowsShown) sourceLoading.set(true) },
  result: (found) => { windowsShown = true; windowItems.set(found); sourceNote.set(found.length ? '' : 'No open windows were found.') },
  error: (reason) => { windowsShown = false; windowItems.set([]); sourceFailure(reason) },
  done: () => sourceLoading.set(false),
}, { serial: true })
const loadEvents = createLatest(() => sources.events(), {
  start: () => { if (!eventsShown) sourceLoading.set(true) },
  result: (found) => { eventsShown = true; eventsAt = Date.now(); eventItems.set(found); sourceNote.set(found.length ? '' : 'Nothing is scheduled in the next two weeks.') },
  error: (reason) => { eventsShown = false; eventItems.set([]); sourceFailure(reason) },
  done: () => sourceLoading.set(false),
}, { serial: true })
const searchFiles = useDebounce((text) => { void loadFiles(text) }, 150)
const searchContacts = useDebounce((text) => { void loadContacts(text) }, 300)
const searchableVisible = derived(() => paletteVisible() && !settings() && !editor() && !packageDetail())
effect(() => {
  const mode = category()
  const text = query().trim()
  const visible = searchableVisible()
  const enabled = searchSettings().files
  searchFiles.cancel(); searchContacts.cancel(); loadFiles.cancel(); loadContacts.cancel()
  sourceLoading.set(false)
  if (!visible) return
  if (mode === 'file' || mode === 'all') {
    const wanted = text.length >= (mode === 'file' ? fileTabMinimum : inlineFileMinimum) && !text.startsWith(':') && calculate(text) === null
    if (!wanted || (mode === 'all' && !enabled)) { fileItems.set([]); if (mode === 'file') sourceNote.set(text ? '' : 'Type part of a file name.') ; return }
    searchFiles(text)
  }
  else if (mode === 'contact') {
    if (text.length < 2) { contactItems.set([]); sourceNote.set('Type a name or company.'); return }
    searchContacts(text)
  }
})
effect(() => {
  const mode = category()
  const visible = searchableVisible()
  if (!visible) { loadWindows.cancel(); loadEvents.cancel(); return }
  if (mode === 'window') void loadWindows('')
  else if (mode === 'event') { if (Date.now() - eventsAt > 20000) void loadEvents('') }
  else { loadWindows.cancel(); loadEvents.cancel() }
})
// A refresh never starts while the last one is still running, so slow scripts cannot stack up.
pollWhile(() => { if (!loadWindows.busy()) void loadWindows('') }, 5000, () => searchableVisible() && category() === 'window')
pollWhile(() => { if (!loadEvents.busy()) void loadEvents('') }, 60000, () => searchableVisible() && category() === 'event')

async function refreshRates() {
  if (!searchSettings().currency) return
  try {
    const rows = await api('exchange-rates/refresh', 'POST')
    exchangeRates.set(rows)
  }
  catch { try { exchangeRates.set(await api('exchange-rates/table')) } catch { /* Conversions keep saying rates are unavailable. */ } }
}
pollWhile(refreshRates, 3600000, () => preferencesReady() && searchSettings().currency)
effect(() => { if (preferencesReady() && searchSettings().currency) void refreshRates() })

async function saveSearch(patch) {
  try {
    const next = { ...searchSettings(), ...patch }
    await preference('search', JSON.stringify(next))
    searchSettings.set(next)
    behavior.paste = next.paste
  }
  catch (reason) { fail(reason) }
}

function extensionSummary(row) {
  const parsed = parseExtension(row.manifest)
  return parsed.ok ? parsed.manifest.version + ' · ' + plural(parsed.manifest.commands.length, 'command') : 'This manifest is not valid and is ignored.'
}
async function installExtension() {
  const parsed = parseExtension(extensionDraft())
  if (!parsed.ok) { extensionIssues.set(parsed.errors); return }
  extensionIssues.set([])
  try {
    const existing = extensionRows().find(row => row.name === parsed.manifest.name)
    const saved = await api('extensions' + (existing ? '/' + existing.id : ''), existing ? 'PATCH' : 'POST', { name: parsed.manifest.name, manifest: extensionDraft(), enabled: true })
    extensionRows.set(existing ? extensionRows().map(row => row.id === existing.id ? saved : row) : [...extensionRows(), saved])
    extensionDraft.set('')
  }
  catch (reason) { extensionIssues.set([reason.message]) }
}
async function toggleExtension(row) {
  try {
    const saved = await api('extensions/' + row.id, 'PATCH', { enabled: !row.enabled })
    extensionRows.set(extensionRows().map(item => item.id === row.id ? saved : item))
  }
  catch (reason) { fail(reason) }
}
async function removeExtension(row) {
  if (!await stxConfirm('Remove the extension "' + row.name + '"? Its commands disappear from search.')) return
  try { await api('extensions/' + row.id, 'DELETE'); extensionRows.set(extensionRows().filter(item => item.id !== row.id)) }
  catch (reason) { fail(reason) }
}

async function revealActive() {
  const item = active()
  if (!item || item.kind !== 'file') return
  try { await revealInFinder(item.content); await dismissLauncher() }
  catch (reason) { fail(reason) }
}
async function copySecondary() {
  const text = secondary().copy
  if (!text) return
  try { await clipboard.writeText(text); status.set('Copied'); await dismissLauncher() }
  catch (reason) { fail(reason) }
}
function cycleCategory(step) { chooseCategory(nextCategory(category(), step)); void nextTick(() => document.querySelector('.tab.active')?.scrollIntoView({ inline: 'nearest', block: 'nearest' })) }

async function run(item = active()) {
  if (!item || saving()) return
  if (item.kind === 'pantry') {
    packageDetail.set(item)
    return
  }
  if (item.kind === 'setup') {
    settingsSection.set(item.content)
    openSettings()
    return
  }
  if (item.kind === 'system') {
    const command = systemCommand(item.content)
    if (command?.confirm && !await stxConfirm(command.confirm)) return
  }
  clearError()
  saving.set(true)
  try {
    await execute(item, query(), duration => recordExecution(item, duration))
    if (isRankable(item.kind)) {
      const saved = await api('ranking', 'POST', { key: item.key, action: 'launch' })
      records.set({ ...records(), [item.key]: { ...saved, lastUsed: saved.lastUsed ?? saved.last_used } })
    }
  }
  catch (reason) { fail(reason) }
  finally { saving.set(false) }
}

async function favorite() {
  const item = active()
  if (!item || !isRankable(item.kind)) return
  try {
    const saved = await api('ranking', 'POST', { key: item.key, action: 'favorite' })
    records.set({ ...records(), [item.key]: { ...saved, lastUsed: saved.lastUsed ?? saved.last_used } })
  }
  catch (reason) { fail(reason) }
}

function newCommand() {
  aliasApplication.set(null)
  editId.set(null)
  title.set('')
  content.set('')
  alias.set('')
  editor.set(true)
  clearError()
  void nextTick(() => commandTitle.current?.focus())
}
function editCommand() {
  const item = active()
  if (item?.kind === 'application') {
    aliasApplication.set(item)
    applicationAliases.set(records()[item.key]?.aliases || '')
    editor.set(true)
    clearError()
    void nextTick(() => aliasInput.current?.focus())
    return
  }
  if (!item?.id || !['quicklink', 'snippet'].includes(item.kind)) return
  aliasApplication.set(null)
  editId.set(item.id)
  title.set(item.title)
  kind.set(item.kind)
  content.set(item.content)
  alias.set(item.alias || '')
  editor.set(true)
  clearError()
  void nextTick(() => commandTitle.current?.focus())
}
async function saveCommand() {
  saving.set(true)
  try {
    const application = aliasApplication()
    if (application) {
      const aliases = parseApplicationAliases(applicationAliases())
      if (aliases.length > 20 || aliases.some(value => value.length > 64)) throw new Error('Use up to 20 aliases, with at most 64 characters each.')
      const record = records()[application.key]
      if (record || aliases.length) {
        const saved = await api('ranking', 'POST', { key: application.key, action: 'aliases', aliases: aliases.join('\n') })
        records.set({ ...records(), [application.key]: { ...saved, lastUsed: saved.lastUsed ?? saved.last_used } })
      }
      closeEditor()
      return
    }
    const name = title().trim()
    if (!name) throw new Error('Give the command a name.')
    const text = kind() === 'quicklink' ? content().trim() : content()
    if (!text.trim()) throw new Error(kind() === 'quicklink' ? 'Enter the quicklink address.' : 'Enter the text to copy.')
    if (kind() === 'quicklink') quicklinkUrl(text, '')
    await api('commands' + (editId() === null ? '' : '/' + editId()), editId() === null ? 'POST' : 'PATCH', { title: name, kind: kind(), content: text, alias: alias().trim() })
    if (editId() === null) track('command_created', { kind: kind() })
    editor.set(false)
    await reload()
  }
  catch (reason) { fail(reason) }
  finally { saving.set(false) }
}

async function saveClipboard() {
  try { await api('clipboard-entries', 'POST', { content: await captureClipboard(), capturedAt: Date.now() }); track('clipboard_saved', { kind: 'clipboard' }); category.set('clipboard'); query.set(''); await reloadHistory() }
  catch (reason) { fail(reason) }
}

async function remove() {
  const item = active()
  if (!item?.id || !['snippet', 'quicklink', 'clipboard'].includes(item.kind)) return
  try {
    await api((item.kind === 'clipboard' ? 'clipboard-entries/' : 'commands/') + item.id, 'DELETE')
    // Favorites and launch counts for a deleted item would otherwise stay in the database.
    const record = records()[item.key]
    if (record) await api('launch-records/' + record.id, 'DELETE').catch(() => {})
    await reload()
  }
  catch (reason) { fail(reason) }
}

function key(event) {
  if (event.key === 'Escape') {
    event.preventDefault()
    void dismissLauncher()
    return
  }
  if (event.metaKey && event.key === ',') { event.preventDefault(); if (settings()) closeSettings(); else openSettings(); return }
  if (settings() || packageDetail()) return
  if (event.metaKey && event.key.toLowerCase() === 'g') { event.preventDefault(); chooseCategory('github'); return }
  if (event.metaKey && event.shiftKey && event.key.toLowerCase() === 'v') { event.preventDefault(); chooseCategory('clipboard'); return }
  if (event.metaKey && event.key.toLowerCase() === 'n') { event.preventDefault(); newCommand(); return }
  if (editor()) return
  if (event.metaKey && (event.key === ']' || event.key === '[')) { event.preventDefault(); cycleCategory(event.key === ']' ? 1 : -1); return }
  const target = event.target
  if (target !== search.current && target?.closest?.('button, select, input, textarea, a, [contenteditable="true"]')) return
  if (event.metaKey && event.key === 'Enter') { event.preventDefault(); void revealActive(); return }
  if (event.metaKey && event.shiftKey && event.key.toLowerCase() === 'c') { event.preventDefault(); void copySecondary(); return }
  if (event.metaKey && event.key.toLowerCase() === 'd') { event.preventDefault(); void favorite(); return }
  if (event.metaKey && event.key.toLowerCase() === 'e') { event.preventDefault(); editCommand(); return }
  if (event.metaKey && event.key === 'Backspace') { event.preventDefault(); query.set(''); selected.set(0); void nextTick(() => search.current?.focus()); return }
  const move = selectionTarget(event, selected(), results().length)
  if (move !== null) {
    event.preventDefault()
    const index = move
    const top = Math.max(0, index * resultRowHeight - 2 * resultRowHeight)
    batch(() => { selected.set(index); resultScrollTop.set(top) })
    void nextTick(() => { if (selected() === index) list.current?.scrollTo({ top }) })
  }
  if (event.key === 'Enter') { event.preventDefault(); void run() }
}

effect(() => { query(); category(); items(); selected.set(0); visibleLimit.set(100); resultScrollTop.set(0); if (list.current) list.current.scrollTop = 0 })
useEventListener('keydown', key, { capture: true })
onMount(() => {
  const resize = new ResizeObserver(entries => resultViewportHeight.set(entries[0]?.contentRect.height || 450))
  if (list.current) resize.observe(list.current)
  const stopBlur = windowEvents.onBlur(() => { void dismissLauncher() })
  const stopFocus = windowEvents.onFocus(() => { paletteVisibility(true); void refreshApplications().catch(fail); if (settings() && settingsSection() === 'general') void refreshLogin(); if (!settings() && !editor() && !packageDetail()) void nextTick(() => search.current?.focus()) })
  const stopClose = windowEvents.onClose(() => paletteVisibility(false))
  const stopMinimize = windowEvents.onMinimize(() => paletteVisibility(false))
  onDestroy(() => { resize.disconnect(); paletteVisibility(false); void flushUsage(); stopBlur(); stopFocus(); stopClose(); stopMinimize() })
})
onMount(async () => {
  try { await loadPreferences(); await menu.set({ menus: standardMenus.leading('Launchpad', { settings: openSettings }) }) } catch (reason) { fail(reason) }
  try { cleanupTray = await configureTray(activate, openSettings, checkForUpdates) } catch (reason) { fail(reason) }
  const firstSetup = preferencesReady() && !preferences().loginInitialized
  await refreshLogin(true)
  if (firstSetup) openSettings()
  await reload()
  try { cleanup = await registerLauncher(activate) }
  catch (reason) { fail(reason) }
  void refreshUpdate()
  if (paletteVisible() && !settings()) activate()
  await Promise.allSettled([
    (async () => { try { catalog.set(await api('pantry/catalog')) } catch (reason) { pantryStatus.set(reason.message) } })(),
    refreshPackages(),
    (async () => { try { githubViewer.set(await restoreGitHub()) } catch (reason) { githubStatus.set(reason.message) } })(),
  ])
})
onDestroy(() => { cleanup(); cleanupTray() })
</script>

<main class="flex flex-col w-full" aria-label="Launchpad">
  <div class="palette-content" x-show="!settings() && !editor() && !packageDetail()">
  <header class="flex gap-4 items-center px-6" @mousedown="nativeWindow.startDrag()">
    <span class="i-f7-search search-icon" aria-hidden="true"></span>
    <input ref="search" x-model="query" type="search" placeholder="Search anything, do something." autocomplete="off" spellcheck="false" role="combobox" aria-label="Search applications and commands" aria-autocomplete="list" aria-controls="result-list" :aria-expanded="results().length > 0" :aria-activedescendant="active() ? 'result-' + selected() : null" @mousedown.stop="">
    <button type="button" class="escape" @click="dismissLauncher()" aria-label="Hide Launchpad">esc</button>
  </header>
  <nav class="flex gap-1 items-center px-5" aria-label="Search categories">
    <div class="flex flex-1 gap-1 items-center categories">
      <button type="button" :class="category() === 'all' ? 'tab active' : 'tab'" :aria-pressed="category() === 'all'" @click="chooseCategory('all')">All</button>
      <button type="button" :class="category() === 'application' ? 'tab active' : 'tab'" :aria-pressed="category() === 'application'" @click="chooseCategory('application')" aria-label="Applications">Apps</button>
      <button type="button" :class="category() === 'file' ? 'tab active' : 'tab'" :aria-pressed="category() === 'file'" @click="chooseCategory('file')">Files</button>
      <button type="button" :class="category() === 'quicklink' ? 'tab active' : 'tab'" :aria-pressed="category() === 'quicklink'" @click="chooseCategory('quicklink')" aria-label="Quicklinks">Links</button>
      <button type="button" :class="category() === 'snippet' ? 'tab active' : 'tab'" :aria-pressed="category() === 'snippet'" @click="chooseCategory('snippet')">Snippets</button>
      <button type="button" :class="category() === 'clipboard' ? 'tab active' : 'tab'" :aria-pressed="category() === 'clipboard'" @click="chooseCategory('clipboard')">Clipboard</button>
      <button type="button" :class="category() === 'emoji' ? 'tab active' : 'tab'" :aria-pressed="category() === 'emoji'" @click="chooseCategory('emoji')">Emoji</button>
      <button type="button" :class="category() === 'window' ? 'tab active' : 'tab'" :aria-pressed="category() === 'window'" @click="chooseCategory('window')">Windows</button>
      <button type="button" :class="category() === 'contact' ? 'tab active' : 'tab'" :aria-pressed="category() === 'contact'" @click="chooseCategory('contact')" aria-label="Contacts">People</button>
      <button type="button" :class="category() === 'event' ? 'tab active' : 'tab'" :aria-pressed="category() === 'event'" @click="chooseCategory('event')" aria-label="Calendar events">Calendar</button>
      <button type="button" :class="category() === 'github' ? 'tab active' : 'tab'" :aria-pressed="category() === 'github'" @click="chooseCategory('github')">GitHub</button>
      <button type="button" :class="category() === 'pantry' ? 'tab active' : 'tab'" :aria-pressed="category() === 'pantry'" @click="chooseCategory('pantry')">Pantry</button>
    </div>
    <button type="button" class="new" @click="newCommand()" title="New command (Command N)" aria-label="New command"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
    <button type="button" class="tab" @click="openSettings()" title="Settings (Command ,)" aria-label="Settings"><span class="i-f7-gear-alt" aria-hidden="true"></span></button>
  </nav>
  <div :if="error()" class="error error-banner" role="alert"><span>{{ error() }}</span><button :if="errorPermission()" type="button" class="error-action" @click="openPrivacySettings(errorPermission())">{{ errorPermission() === 'automation' ? 'Open Automation settings' : 'Open Accessibility settings' }}</button></div>
  <div :if="category() === 'github'" class="flex gap-2 items-center px-5 github-tools">
    <select x-model="githubView" aria-label="GitHub view"><option value="repositories">Repositories</option><option value="issues">Issues</option><option value="pulls">Pull requests</option><option value="assigned">Assigned to me</option><option value="reviews">Review requests</option><option value="notifications">Notifications</option></select>
    <input x-model="githubScope" @change="saveScope()" placeholder="owner/repository" aria-label="GitHub repository scope">
    <button type="button" class="text-action" @click="refreshGitHub()">Refresh</button>
  </div>
  <div :if="category() === 'pantry'" class="flex gap-2 items-center px-5 github-tools">
    <select x-model="pantryFilter" aria-label="Package type"><option value="all">All packages</option><option value="app">Applications</option><option value="cli">Command line tools</option><option value="library">Libraries</option><option value="font">Fonts</option></select>
    <span class="help">{{ plural(catalog().length, 'package') }}</span><button type="button" class="ml-auto text-action" @click="refreshCatalog()" :disabled="packageBusy()">Refresh catalog</button>
  </div>
  <section class="flex flex-1 flex-col min-h-0" aria-label="Search results">
    <div class="flex items-center justify-between px-6 section-label">
      <span>{{ category() === 'clipboard' ? 'Clipboard History' : category() === 'github' ? 'GitHub' : category() === 'pantry' ? 'Pantry catalog' : query() ? 'Results' : 'Your launchpad' }}</span>
      <button :if="category() === 'clipboard'" type="button" class="text-action" @click="saveClipboard()">Save current clipboard</button>
      <span :if="category() !== 'clipboard'" role="status" aria-live="polite">{{ results().length }}{{ allResults().length > results().length ? ' of ' + allResults().length : '' }} available</span>
    </div>
    <div class="result-region">
    <div ref="results" id="result-list" class="px-3 results" role="listbox" aria-label="Matching commands" @scroll="scrollResults($event)">
      <p :if="loading() || (category() === 'github' && githubLoading()) || (sourceLoading() && results().length === 0)" class="empty" role="status">{{ category() === 'github' ? 'Searching GitHub...' : loading() ? 'Finding your applications...' : 'Looking...' }}</p>
      <div :if="!loading() && !githubLoading() && !sourceLoading() && results().length === 0" class="empty">
        <p>{{ category() === 'clipboard' ? 'Keep useful text close.' : 'Nothing here yet.' }}</p>
        <p class="empty-detail">{{ category() === 'clipboard' ? 'Enable Clipboard History in Settings, or save the current clipboard yourself.' : category() === 'github' ? githubStatus() : ['file', 'window', 'contact', 'event'].includes(category()) && sourceNote() ? sourceNote() : category() === 'emoji' ? 'Try a word like rocket, party or thumbs up.' : category() === 'all' ? 'No matching installed commands. Browse Pantry to discover more tools, or create a command with Command N.' : 'Try another search, or create a quicklink or snippet with Command N.' }}</p>
      </div>
      <div aria-hidden="true" :style="'height:' + viewport().top + 'px;flex-shrink:0'"></div>
      <!-- Park unused slots so fast typing and backspacing never need to recreate result rows. -->
      <button :for="(item, index) in renderedResults()" :key="index" x-show="index < viewport().end - viewport().start" :disabled="index >= viewport().end - viewport().start" :aria-hidden="index >= viewport().end - viewport().start" :id="'result-' + (viewport().start + index)" type="button" role="option" :aria-posinset="viewport().start + index + 1" :aria-setsize="results().length" :aria-selected="index < viewport().end - viewport().start && viewport().start + index === selected()" :class="viewport().start + index === selected() ? 'result selected' : 'result'" @click="selected.set(viewport().start + index); run(item)" @mousemove="selected.set(viewport().start + index)">
        <span class="item-icon" aria-hidden="true">
          <img :if="['application', 'pantry'].includes(item.kind) && item.icon" :src="item.icon" :class="item.package ? 'package-logo' : ''" alt="" width="34" height="34" loading="lazy" decoding="async">
          <span :if="item.kind === 'application' && !item.icon" class="i-f7-square-grid-2x2"></span>
          <span :if="item.kind === 'pantry' && !item.icon" class="i-f7-cube-box"></span>
          <span :if="item.kind === 'quicklink'" class="i-f7-link"></span>
          <span :if="item.kind === 'snippet'" class="i-f7-text-alignleft"></span>
          <span :if="item.kind === 'clipboard'" class="i-f7-doc-on-clipboard"></span>
          <span :if="item.kind === 'calculator'" class="i-f7-number"></span>
          <span :if="item.kind === 'github'" class="i-f7-chevron-left-slash-chevron-right"></span>
          <span :if="item.kind === 'file'" :class="item.subtitle.startsWith('Folder') ? 'i-f7-folder' : 'i-f7-doc'"></span>
          <span :if="item.kind === 'system' || item.kind === 'setup'" class="i-f7-gear-alt"></span>
          <span :if="item.kind === 'web'" class="i-f7-globe"></span>
          <span :if="item.kind === 'window'" class="i-f7-macwindow"></span>
          <span :if="item.kind === 'contact'" class="i-f7-person-crop-circle"></span>
          <span :if="item.kind === 'event'" class="i-f7-calendar"></span>
          <span :if="item.kind === 'emoji'" class="i-f7-smiley"></span>
        </span>
        <span class="result-copy"><span class="result-title" :title="item.title">{{ item.title }}</span><span class="result-subtitle" :title="item.subtitle">{{ item.subtitle }}</span></span>
        <span :if="item.kind === 'pantry'" class="package-badge">{{ item.installedVersion ? 'Installed' : item.package?.kind }}</span>
        <span :if="item.favorite" class="star" aria-label="Favorite">★</span>
        <span :if="viewport().start + index === selected()" class="return-key" aria-hidden="true">↵</span>
      </button>
      <div aria-hidden="true" :style="'height:' + viewport().bottom + 'px;flex-shrink:0'"></div>
    </div>
    <pre :if="category() === 'clipboard' && active()" class="clipboard-preview" aria-label="Selected clipboard text">{{ active().content }}</pre>
    </div>
  </section>
  <div :if="category() === 'clipboard'" class="flex gap-3 items-center px-5 history-tools">
    <span>{{ historyEnabled() ? historyStatus() : 'History paused · ' + historyDays() + ' day retention' }}</span>
    <button type="button" class="ml-auto text-action" @click="historyPreference(!historyEnabled())">{{ historyEnabled() ? 'Pause' : 'Enable history' }}</button>
    <button type="button" class="text-action" @click="clearHistory()">Clear history</button>
  </div>
  <p :if="category() === 'github'" class="px-5 github-status" role="status">{{ githubLoading() ? 'Searching GitHub...' : githubStatus() }}</p>
  <p :if="category() === 'pantry'" class="px-5 github-status" role="status">{{ pantryStatus() }}</p>
  <div :if="allResults().length > results().length" class="flex items-center justify-center history-tools"><button type="button" class="text-action" @click="visibleLimit.set(visibleLimit() + 100)">Show {{ Math.min(100, allResults().length - results().length) }} more</button></div>
  <footer class="flex gap-3 items-center px-5">
    <span class="wordmark">Launchpad</span><button :if="updateState().phase === 'ready'" type="button" class="text-action" @click="chooseSettings('updates'); openSettings()">Update ready</button>
    <span class="footer-status">{{ saving() ? 'Saving...' : category() === 'github' ? githubViewer() ? '@' + githubViewer().login : 'Public search' : status() }}</span>
    <button :if="active()?.kind === 'application'" type="button" class="footer-action" @click="editCommand()" aria-label="Edit application search aliases">Aliases <kbd>⌘ E</kbd></button>
    <button :if="active()?.id && ['quicklink', 'snippet'].includes(active()?.kind)" type="button" class="footer-action" @click="editCommand()">Edit <kbd>⌘ E</kbd></button>
    <button :if="active()?.id && ['quicklink', 'snippet', 'clipboard'].includes(active()?.kind)" type="button" class="footer-action" @click="remove()" aria-label="Delete selected saved item">Delete</button>
    <button :if="secondary().reveal" type="button" class="footer-action" @click="revealActive()" aria-label="Reveal in Finder">Reveal <kbd>⌘ ↵</kbd></button>
    <button :if="secondary().copy" type="button" class="footer-action" @click="copySecondary()" :aria-label="active()?.kind === 'file' ? 'Copy path' : 'Copy contact detail'">{{ active()?.kind === 'file' ? 'Copy path' : 'Copy' }} <kbd>⇧⌘ C</kbd></button>
    <button type="button" class="ml-auto footer-action" @click="favorite()" :disabled="!active() || !isRankable(active().kind)" title="Favorite (Command D)" :aria-label="active()?.favorite ? 'Remove from favorites' : 'Add to favorites'" :aria-pressed="Boolean(active()?.favorite)">☆ <kbd>⌘ D</kbd></button>
    <button type="button" class="footer-action primary" @click="run()" :disabled="!active() || saving()">{{ actionLabel() }} <kbd>↵</kbd></button>
  </footer>
  </div>

  <div :if="settings()" class="editor settings" role="dialog" aria-modal="true" aria-label="Launchpad Settings">
    <div class="dialog-header" @mousedown="nativeWindow.startDrag()"><h1 ref="settingsTitle" tabindex="-1">Settings</h1><button type="button" class="escape" @mousedown.stop="" @click="closeSettings()" aria-label="Close settings">esc</button></div>
    <div class="settings-layout">
    <aside class="settings-sidebar">
      <label class="settings-search"><span aria-hidden="true">⌕</span><input type="search" x-model="settingsQuery" placeholder="Search" aria-label="Search settings"></label>
      <nav class="settings-nav" aria-label="Settings sections">
        <button :for="(section, index) in visibleSettings()" :key="section.id" type="button" :class="settingsSection() === section.id ? 'settings-item active' : 'settings-item'" :aria-pressed="settingsSection() === section.id" @click="chooseSettings(section.id)"><span class="settings-icon" :style="'background:' + section.color" aria-hidden="true"><svg viewBox="0 0 24 24"><path :d="section.icon" /></svg></span>{{ section.title }}</button>
      </nav>
      <p :if="!visibleSettings().length" class="help settings-no-results">No settings found.</p>
      <div class="settings-sidebar-about"><strong>Launchpad</strong><span>Version {{ updateState().currentVersion }}</span></div>
    </aside>
    <div class="dialog-body settings-detail">
      <div class="settings-heading"><span class="settings-hero-icon" :style="'background:' + currentSettings().color" aria-hidden="true"><svg viewBox="0 0 24 24"><path :d="currentSettings().icon" /></svg></span><h2>{{ currentSettings().title }}</h2><p class="help">{{ currentSettings().description }}</p></div>
      <section :if="settingsSection() === 'general'">
        <div class="settings-group">
          <label class="toggle-row"><span>Open at Login</span><input type="checkbox" role="switch" :checked="loginEnabled()" :disabled="loginBusy()" @change="changeLogin($event.target.checked)"></label>
          <p class="help" role="status">{{ loginStatus() }}</p>
          <button type="button" class="text-action" :disabled="loginBusy()" @click="refreshLogin()">Refresh login status</button>
        </div>
        <div class="settings-group"><div class="setting-row"><span>Open Launchpad</span><kbd>⌘ Space</kbd></div><p class="help">Click the menu bar icon or use the shortcut to search. Escape and clicking outside hide the palette while Launchpad keeps running.</p></div>
        <button type="button" class="settings-group settings-link" @click="chooseSettings('updates')"><span>Software Update</span><span aria-hidden="true">›</span></button>
      </section>
      <section :if="settingsSection() === 'updates'">
        <div class="settings-group">
          <div class="setting-row"><h2>Launchpad</h2><span class="help">{{ updateState().currentVersion }}</span></div>
          <p class="help update-status" role="status" aria-live="polite">{{ updateMessage() }}</p>
          <progress :if="updateState().phase === 'downloading'" max="100" :value="updateState().percent || 0" aria-label="Update download progress"></progress>
          <button :if="updateState().phase !== 'unavailable' && updateState().phase !== 'ready' && updateState().phase !== 'installed'" type="button" class="secondary-button" :disabled="updateBusy()" @click="updateLaunchpad(updateState().phase === 'available' ? 'download' : 'check')">{{ updateState().phase === 'available' ? 'Download update' : 'Check for Updates...' }}</button>
          <button :if="updateState().phase === 'ready'" type="button" class="save-button" @click="updateLaunchpad('install')">Install and Restart</button>
        </div>
        <div class="settings-group"><label class="toggle-row"><span>Automatic Updates</span><input type="checkbox" role="switch" :checked="automaticUpdatesEnabled()" @change="changeAutomaticUpdates($event.target.checked)"></label><p class="help">Check every six hours and download verified updates in the background. You choose when to install and restart.</p></div>
      </section>
      <section :if="settingsSection() === 'appearance'" class="settings-group">
    <h2>Make yourself at home.</h2><p class="help">Follow your Mac, or choose an appearance for Launchpad.</p>
    <div class="theme-options" role="group" aria-label="Appearance">
      <button type="button" :class="themePreference() === 'system' ? 'theme-option active' : 'theme-option'" @click="appearance('system')" :aria-pressed="themePreference() === 'system'"><span class="system-preview theme-preview"></span>System</button>
      <button type="button" :class="themePreference() === 'light' ? 'theme-option active' : 'theme-option'" @click="appearance('light')" :aria-pressed="themePreference() === 'light'"><span class="light-preview theme-preview"></span>Light</button>
      <button type="button" :class="themePreference() === 'dark' ? 'theme-option active' : 'theme-option'" @click="appearance('dark')" :aria-pressed="themePreference() === 'dark'"><span class="dark-preview theme-preview"></span>Dark</button>
    </div>
      </section>
      <section :if="settingsSection() === 'clipboard'" class="settings-group">
    <h2>Clipboard History</h2>
    <label class="toggle-row"><input type="checkbox" role="switch" :checked="historyEnabled()" @change="historyPreference(!historyEnabled())"> Record new clipboard text</label>
    <p class="help">Stored only on this Mac, up to 200 entries. Protected and transient pasteboard types are skipped, with additional checks for known password managers. Unmarked sensitive text can still be captured. Pause before copying anything you want to keep out of history.</p>
    <label for="history-days">Keep history for</label>
    <select id="history-days" :value="historyDays()" @change="historyPreference(historyEnabled(), $event.target.value)"><option value="1">1 day</option><option value="7">7 days</option><option value="30">30 days</option></select>
    <div class="setting-actions"><span class="help">{{ historyEnabled() ? historyStatus() : 'History is paused' }}</span><button type="button" class="danger-button" @click="clearHistory()">Clear history</button></div>
      </section>
      <section :if="settingsSection() === 'github'" class="settings-group">
    <h2>GitHub {{ githubViewer() ? '· @' + githubViewer().login : '' }}</h2>
    <p class="help">Repository, issue and pull request search works publicly. Connect for private repositories, assigned issues, review requests and notifications. Searches run only in the GitHub tab.</p>
    <form :if="!githubViewer()" @submit.prevent="connectAccount()">
      <label for="github-token">Personal access token</label>
      <input id="github-token" type="password" x-model="tokenInput" autocomplete="off" spellcheck="false" placeholder="Stored in macOS Keychain">
      <p class="help">Use read-only access to selected repositories. Notifications require a classic token with notifications permission. Launchpad never saves the token in its database.</p>
      <div class="flex gap-3 items-center"><button type="submit" class="save-button" :disabled="saving()">Connect GitHub</button><button type="button" class="text-action" @click="openLink('https://github.com/settings/tokens', 'github')">Manage tokens</button></div>
    </form>
    <button :if="githubViewer()" type="button" class="secondary-button" @click="disconnectAccount()">Disconnect GitHub</button>
      </section>
      <section :if="settingsSection() === 'pantry'" class="settings-group">
        <h2>Your tools, through Pantry.</h2>
        <p class="help">Search applications, command line tools, libraries and fonts locally. Installation uses the Pantry CLI you install separately, with your user account and its package permissions.</p>
        <p class="help">Run this once in your terminal, then enter the five minute pairing code below.</p>
        <div class="setup-command"><code>pantry desktop setup --yes</code><button type="button" class="text-action" @click="copySetupCommand()">Copy</button></div>
        <form :if="!pantryReady()" @submit.prevent="connectPackages()"><label for="pantry-code">Pantry pairing code</label><input id="pantry-code" x-model="pantryCode" inputmode="numeric" maxlength="12" autocomplete="off" placeholder="8 digit code"><button type="submit" class="save-button" :disabled="packageBusy() || pantryRestoring() || pairingDigits(pantryCode()).length !== 8">Connect Pantry</button></form>
        <button :if="!pantryReady()" type="button" class="text-action" @click="refreshPackages()" :disabled="packageBusy() || pantryRestoring()">Check saved connection</button>
        <div :if="pantryReady()" class="flex gap-3 items-center"><button type="button" class="secondary-button" @click="refreshPackages()" :disabled="packageBusy() || pantryRestoring()">Refresh connection</button><button type="button" class="text-action" @click="disconnectPackages()" :disabled="pantryRestoring()">Disconnect Pantry</button></div>
        <p class="help" role="status">{{ pantryRestoring() ? 'Waiting for macOS to check the saved connection...' : pantryStatus() }}</p>
        <p class="help">The connection token stays in macOS Keychain. Catalog refreshes and original logos load from Pantry's GitHub repository. Package searches stay on this Mac.</p>
      </section>
      <section :if="settingsSection() === 'search'" class="settings-group">
        <h2>Find more, faster.</h2>
        <label class="toggle-row"><input type="checkbox" role="switch" :checked="searchSettings().files" @change="saveSearch({ files: $event.target.checked })"> Search file names on this Mac</label>
        <p class="help">Uses Spotlight's index. Library, hidden items, dependencies and app internals are skipped. File names stay on this Mac and are not stored.</p>
        <label for="web-engine">When you search, offer a web search with</label>
        <select id="web-engine" :value="searchSettings().web" @change="saveSearch({ web: $event.target.value })"><option value="duckduckgo">DuckDuckGo</option><option value="google">Google</option><option value="bing">Bing</option><option value="brave">Brave Search</option><option value="kagi">Kagi</option><option value="off">Off</option></select>
        <label class="toggle-row"><input type="checkbox" role="switch" :checked="searchSettings().currency" @change="saveSearch({ currency: $event.target.checked })"> Convert currencies</label>
        <p class="help">Downloads the European Central Bank's reference rates about once a day from api.frankfurter.dev. The request carries no search text. Off until you turn it on. Units and temperatures always work offline.</p>
        <label class="toggle-row"><input type="checkbox" role="switch" :checked="searchSettings().paste" @change="saveSearch({ paste: $event.target.checked })"> Paste snippets into the app you were using</label>
        <p class="help">Snippets are always copied. This also types Command V into the previous app, which needs the Accessibility permission. Snippets can use {date}, {time}, {datetime}, {weekday}, {year}, {uuid} and {clipboard}.</p>
        <h2 class="mt-5">Windows, contacts and calendar</h2>
        <p class="help">The Windows, People and Calendar tabs ask macOS for permission the first time. Windows needs Accessibility. Contacts and Calendar use Automation. Result details stay in memory. Local usage records only the command category.</p>
        <div class="flex gap-3 items-center"><button type="button" class="text-action" @click="openPrivacySettings('accessibility')">Accessibility settings</button><button type="button" class="text-action" @click="openPrivacySettings('automation')">Automation settings</button></div>
      </section>
      <section :if="settingsSection() === 'extensions'" class="settings-group">
        <h2>Extensions</h2>
        <p class="help">An extension adds quicklinks and snippets from a JSON file. It cannot run code, use the network or read files, so installing one is as safe as pasting text.</p>
        <div :for="(row, index) in extensionRows()" :key="row.id" class="setting-row"><div><strong>{{ row.name }}</strong><p class="help">{{ extensionSummary(row) }}</p></div><div class="flex gap-3 items-center"><input type="checkbox" role="switch" :checked="row.enabled" @change="toggleExtension(row)" :aria-label="'Enable ' + row.name"><button type="button" class="text-action" @click="removeExtension(row)">Remove</button></div></div>
        <label for="extension-manifest">Install from JSON</label>
        <textarea id="extension-manifest" x-model="extensionDraft" rows="8" spellcheck="false" placeholder="Paste a manifest here"></textarea>
        <div :if="extensionIssues().length" class="error" role="alert"><div :for="(issue, index) in extensionIssues()" :key="index">{{ issue }}</div></div>
        <div class="flex gap-3 items-center"><button type="button" class="save-button" @click="installExtension()" :disabled="!extensionDraft().trim()">Install</button><button type="button" class="text-action" @click="extensionDraft.set(sampleManifest)">Use an example</button></div>
      </section>
      <section :if="settingsSection() === 'usage'" class="settings-group">
    <div class="setting-row"><div><h2>Your year, in commands.</h2><p class="help">Keep local activity for your future year review.</p></div><input type="checkbox" role="switch" :checked="usageEnabled()" @change="usagePreference(!usageEnabled())" aria-label="Record local usage"></div>
    <p class="help">Records app sessions, time running, time the palette is open, app and link launches, action types, application names and command latency through the local API. Search text, file paths, snippet and clipboard contents stay out of usage records. Nothing is sent to Stacks.</p>
    <div :if="usageSummary()" class="usage-stats"><div><strong>{{ usageSummary().sessions }}</strong><span>app sessions</span></div><div><strong>{{ usageSummary().paletteOpens }}</strong><span>palette opens</span></div><div><strong>{{ formatUsageTime(usageSummary().runningMs) }}</strong><span>app running</span></div><div><strong>{{ formatUsageTime(usageSummary().visibleMs) }}</strong><span>palette open</span></div><div><strong>{{ usageSummary().applicationsOpened }}</strong><span>apps opened</span></div><div><strong>{{ usageSummary().linksOpened }}</strong><span>links opened</span></div><div><strong>{{ usageSummary().commands }}</strong><span>commands</span></div><div><strong>{{ usageSummary().activeDays }}</strong><span>active days</span></div><div><strong>{{ usageSummary().longestStreak }}</strong><span>day streak</span></div></div>
    <div :if="usageSummary()?.pantry">
      <h2>Pantry installs</h2>
      <p class="help">Confirmed jobs requested through Launchpad. Retries count once. Failed installs are separate.</p>
      <div class="usage-stats"><div><strong>{{ usageSummary().pantry.installed }}</strong><span>successful installs</span></div><div><strong>{{ usageSummary().pantry.byKind.app }}</strong><span>apps installed</span></div><div><strong>{{ usageSummary().pantry.byKind.cli }}</strong><span>CLI tools installed</span></div><div><strong>{{ usageSummary().pantry.byKind.library }}</strong><span>libraries installed</span></div><div><strong>{{ usageSummary().pantry.byKind.font }}</strong><span>fonts installed</span></div><div><strong>{{ usageSummary().pantry.failed }}</strong><span>failed installs</span></div></div>
      <p class="help">Successful install time: {{ formatUsageTime(usageSummary().pantry.installMs) }} across {{ usageSummary().pantry.timedInstalls }} timed installs.</p>
    </div>
    <div class="setting-actions"><span class="help">{{ usageEnabled() ? 'Recording locally' : 'Usage recording paused' }}</span><button type="button" class="danger-button" @click="clearUsage()">Clear usage history</button></div>
    <p :if="usageIssue()" class="help" role="status">{{ usageIssue() }}</p>
      </section>
      <p :if="error()" class="error" role="alert">{{ error() }}</p>
    </div>
    </div>
    <div class="dialog-footer"><span class="help">Saved on this Mac</span><button type="button" class="secondary-button" @click="closeSettings()">Done</button></div>
  </div>

  <div :if="packageDetail()" class="editor" role="dialog" aria-modal="true" aria-label="Pantry package details">
    <div class="dialog-header" @mousedown="nativeWindow.startDrag()"><h1>{{ packageDetail().title }}</h1><button type="button" class="escape" @mousedown.stop="" @click="closePackage()">esc</button></div>
    <div class="dialog-body">
      <div class="package-heading"><img :if="packageDetail().icon" :src="packageDetail().icon" class="package-logo" width="48" height="48" alt=""><div><h2>{{ packageDetail().title }}</h2><p class="help">{{ packageDetail().package?.kind }} · {{ packageDetail().content }}</p></div></div>
      <p class="package-description">{{ packageDetail().package?.description }}</p>
      <div class="flex gap-3 items-center"><span class="package-badge">{{ pantryInstalled().find(item => item.name === packageDetail().content)?.version || packageDetail().package?.latestVersion || 'Latest available' }}</span><button :if="packageDetail().package?.homepageUrl" type="button" class="text-action" @click="openLink(packageDetail().package.homepageUrl, 'pantry')">Project website ↗</button><button :if="packageDetail().package?.githubUrl" type="button" class="text-action" @click="openLink(packageDetail().package.githubUrl, 'pantry')">GitHub ↗</button></div>
      <p class="help">Pantry selects the compatible artifact and installs dependencies. A listed package may be unavailable for this Mac. Installation runs in the separately installed Pantry service.</p>
      <p class="help" role="status">{{ installJob() ? installJob().status === 'succeeded' ? 'Installed successfully' : installJob().status === 'failed' ? installJob().error : 'Pantry is ' + installJob().status : pantryStatus() }}</p>
      <pre :if="installJob()?.output" class="package-output" aria-label="Pantry installation output">{{ installJob().output }}</pre>
    </div>
    <div class="dialog-footer"><button type="button" class="secondary-button" @click="closePackage()">Back</button><button :if="packageAppPath()" type="button" class="secondary-button" @click="openPackageApplication()">Open application</button><button type="button" class="save-button" @click="startInstall()" :disabled="packageBusy() || (installJob() && ['queued', 'running', 'succeeded'].includes(installJob().status))">{{ !pantryReady() ? 'Connect Pantry' : installJob()?.status === 'succeeded' ? 'Installed' : installJob()?.status === 'failed' ? 'Retry installation' : installJob() ? 'Installing...' : 'Install with Pantry' }}</button></div>
  </div>

  <div :if="editor()" class="editor" role="dialog" aria-modal="true" :aria-label="aliasApplication() ? 'Application search aliases' : editId() === null ? 'New command' : 'Edit command'">
    <form class="dialog-form" @submit.prevent="saveCommand()">
      <div class="dialog-header" @mousedown="nativeWindow.startDrag()"><h1>{{ aliasApplication() ? 'Search aliases' : editId() === null ? 'New command' : 'Edit command' }}</h1><button type="button" class="escape" @mousedown.stop="" @click="closeEditor()">esc</button></div>
      <div class="dialog-body">
      <div :if="aliasApplication()">
        <h2>{{ aliasApplication().title }}</h2>
        <p class="help">Add names you naturally use for this app. Built-in names keep working.</p>
        <p :if="builtInApplicationAliases()" class="help">Built-in aliases: {{ builtInApplicationAliases() }}</p>
        <label for="application-aliases">Your aliases <span class="muted">(optional)</span></label>
        <textarea ref="aliasInput" id="application-aliases" x-model="applicationAliases" maxlength="1000" rows="5" placeholder="One per line, or separated by commas"></textarea>
        <p class="help">Up to 20 aliases. Saved only on this Mac. Clear this field to remove your aliases.</p>
      </div>
      <div :if="!aliasApplication()">
      <label for="command-kind">Type</label>
      <select id="command-kind" x-model="kind"><option value="quicklink">Quicklink</option><option value="snippet">Snippet</option></select>
      <label for="command-title">Name</label>
      <input ref="commandTitle" id="command-title" x-model="title" required maxlength="120" placeholder="Something you use every day">
      <label for="command-content">{{ kind() === 'quicklink' ? 'URL' : 'Text to copy' }}</label>
      <textarea id="command-content" x-model="content" required maxlength="20000" rows="3" :placeholder="kind() === 'quicklink' ? 'https://example.com/search?q={query}' : 'Your reusable text'"></textarea>
      <p class="help">{{ kind() === 'quicklink' ? 'Use {query} in the URL to include your search text.' : 'Snippets copy to your clipboard. Paste them wherever you need.' }}</p>
      <label for="command-alias">Search alias <span class="muted">(optional)</span></label>
      <input id="command-alias" x-model="alias" maxlength="40" placeholder="A short name to find this faster">
      </div>
      <p :if="error()" class="error" role="alert">{{ error() }}</p>
      </div>
<div class="dialog-footer"><button type="button" class="secondary-button" @click="closeEditor()">Cancel</button><button class="save-button" type="submit" :disabled="saving()">{{ saving() ? 'Saving...' : aliasApplication() ? 'Save aliases' : editId() === null ? 'Create command' : 'Save changes' }}</button></div>
    </form>
  </div>
</main>
</body>
<style>
:root { color-scheme: light; --surface: #ffffff; --ink: #202735; --muted: #566173; --line: #d9e0e9; --accent: #245eb7; --selected: #e7edf6; --icon-surface: #e8eef7; --footer: #f3f5f8; --key: #e0e6ee; --field: #ffffff; --border: #8391a5; --outline: #b8c3d3; --selected-border: #b6c9e4; --error-bg: #fde9e9; --error-ink: #922634; }
:root.dark { color-scheme: dark; --surface: #202226; --ink: #f2f3f5; --muted: #b2b8c4; --line: #35383f; --accent: #a9cbff; --selected: #343943; --icon-surface: #2d323c; --footer: #1c1e22; --key: #32363e; --field: #272a31; --border: #657185; --outline: #525a68; --selected-border: #53627a; --error-bg: #432b2e; --error-ink: #ffccd1; }
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; overflow: hidden; background: transparent; color: var(--ink); font: 13px/1.4 -apple-system, BlinkMacSystemFont, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; border: 0; background: transparent; }
button:disabled { opacity: .5; cursor: default; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
main { height: 100dvh; position: relative; overflow: hidden; background: var(--surface); border: 1px solid var(--outline); border-radius: 12px; }
.palette-content { display: flex; flex-direction: column; height: 100%; min-height: 0; }
header { height: 72px; flex-shrink: 0; }
.search-icon { width: 22px; height: 22px; color: var(--muted); flex-shrink: 0; }
header input { width: 100%; min-width: 0; font-size: 21px; letter-spacing: -.5px; background: transparent; border: none; padding: 8px 0; outline: none; }
header input::placeholder { color: var(--muted); }
input::-webkit-search-cancel-button { display: none; }
.escape { border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px; font-size: 11px; color: var(--muted); }
nav { height: 40px; border-bottom: 1px solid var(--line); flex-shrink: 0; }
.categories { min-width: 0; overflow-x: auto; scrollbar-width: none; }
.categories::-webkit-scrollbar { display: none; }
.tab { padding: 5px 11px; border-radius: 6px; color: var(--muted); font-size: 12px; white-space: nowrap; flex-shrink: 0; }
.tab:hover { color: var(--ink); background: var(--selected); }
.tab.active { background: var(--selected); color: var(--ink); }
.new { color: var(--muted); display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex-shrink: 0; }
.new svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
.section-label { height: 30px; font-size: 11px; color: var(--muted); flex-shrink: 0; }
.section-label > span:last-child { color: var(--muted); font-size: 10px; }
.results { flex: 1; overflow-y: auto; overflow-anchor: none; padding-bottom: 8px; }
.result { display: flex; align-items: center; gap: 13px; width: 100%; height: 52px; padding: 7px 12px; border: 1px solid transparent; text-align: left; border-radius: 7px; margin: 0; }
.result.selected { background: var(--selected); border-color: var(--selected-border); }
.item-icon { width: 33px; height: 33px; display: flex; align-items: center; justify-content: center; border-radius: 8px; background: var(--icon-surface); color: var(--accent); flex-shrink: 0; }
.item-icon > span { width: 19px; height: 19px; }
.result-copy { display: flex; flex-direction: column; min-width: 0; flex: 1; gap: 1px; }
.result-title { font-size: 13px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result-subtitle { color: var(--muted); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.star { color: var(--accent); font-size: 11px; }
.return-key { color: var(--muted); font-size: 17px; }
footer { height: 44px; flex-shrink: 0; border-top: 1px solid var(--line); background: var(--footer); }
.wordmark { font-size: 12px; font-weight: 650; letter-spacing: -.3px; }
.footer-status { color: var(--muted); font-size: 10px; max-width: 230px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.footer-action { color: var(--muted); font-size: 11px; white-space: nowrap; display: flex; align-items: center; gap: 7px; }
.footer-action.primary { color: var(--ink); }
kbd { font: 10px -apple-system, system-ui; color: var(--muted); padding: 2px 4px; border-radius: 4px; background: var(--key); }
.empty { margin: 35px auto; max-width: 340px; text-align: center; font-size: 16px; color: var(--ink); }
.empty-detail { color: var(--muted); font-size: 12px; line-height: 1.6; }
.text-action { color: var(--accent); font-size: 11px; }
.error { margin: 6px 20px; padding: 8px 10px; background: var(--error-bg); color: var(--error-ink); border-radius: 5px; font-size: 12px; }
.error-banner { display: flex; gap: 10px; align-items: flex-start; justify-content: space-between; }
.error-action { flex: none; font-size: 11px; color: var(--error-ink); text-decoration: underline; white-space: nowrap; }
.editor { position: absolute; inset: 0; background: var(--surface); z-index: 10; display: flex; flex-direction: column; min-height: 0; }
.editor h1 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: -.5px; }
.editor label { display: block; font-size: 12px; margin: 8px 0 4px; color: var(--ink); }
.editor input, .editor textarea, .editor select { width: 100%; border: 1px solid var(--border); border-radius: 6px; background: var(--field); padding: 8px 10px; }
.editor input::placeholder, .editor textarea::placeholder { color: var(--muted); }
.editor textarea { height: 64px; min-height: 64px; max-height: 160px; resize: vertical; }
.help, .muted { color: var(--muted); font-size: 11px; }
.help { margin: 6px 0; }
.secondary-button, .save-button { padding: 7px 13px; border-radius: 6px; }
.secondary-button { background: var(--selected); }
.save-button { background: #aecfff; color: #172538; font-weight: 600; }
@media (max-width: 600px) { header { padding-inline: 16px; } header input { font-size: 18px; } .footer-status { display: none; } .tab { padding-inline: 7px; } }
@media (prefers-reduced-motion: no-preference) { .tab, .result { transition: background-color 90ms ease; } }
header input:focus-visible { outline: none; }
.item-icon > img { width: 34px; height: 34px; object-fit: contain; }
.github-tools { height: 40px; flex-shrink: 0; border-bottom: 1px solid var(--line); }
.github-tools select, .github-tools input { min-width: 0; padding: 4px 7px; border: 1px solid var(--border); border-radius: 5px; background: var(--field); font-size: 11px; }
.github-tools input { flex: 1; }
.github-status { margin: 0; height: 28px; flex-shrink: 0; color: var(--muted); font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-tools { min-height: 34px; flex-shrink: 0; font-size: 10px; color: var(--muted); border-top: 1px solid var(--line); }
.settings h2 { font-size: 14px; margin: 0 0 6px; }
.settings .toggle-row { display: flex; align-items: center; gap: 9px; }
.settings .toggle-row input { width: auto; }
.tab > span { display: block; width: 17px; height: 17px; }
.dialog-form { display: flex; flex-direction: column; height: 100%; min-height: 0; }
.dialog-header { display: flex; align-items: center; justify-content: space-between; height: 52px; padding: 0 20px; flex-shrink: 0; border-bottom: 1px solid var(--line); }
.dialog-header h1:focus { outline: none; }
.dialog-body { flex: 1; min-height: 0; overflow: auto; padding: 12px 20px; }
.dialog-footer { display: flex; align-items: center; justify-content: flex-end; gap: 12px; flex-shrink: 0; min-height: 52px; padding: 9px 20px; border-top: 1px solid var(--line); background: var(--footer); }
.dialog-footer > .help { margin-right: auto; }
.dialog-body .error { margin: 10px 0 0; }
.settings-layout { display: grid; grid-template-columns: 190px minmax(0, 1fr); flex: 1; min-height: 0; }
.settings-sidebar { display: flex; flex-direction: column; min-height: 0; background: var(--footer); border-right: 1px solid var(--line); padding: 14px 10px 10px; }
.settings-search { display: flex !important; align-items: center; gap: 5px; padding: 0 8px; margin: 0 0 14px !important; border: 1px solid var(--line); border-radius: 7px; background: var(--field); color: var(--muted); }
.settings-search input { border: 0; background: transparent; padding: 6px 0; font-size: 12px; }
.settings-nav { display: flex; flex-direction: column; gap: 3px; height: auto; min-height: 0; overflow-y: auto; border: 0; }
.settings-item { display: flex; align-items: center; gap: 9px; width: 100%; text-align: left; padding: 6px 8px; border-radius: 6px; font-size: 12px; flex-shrink: 0; }
.settings-item:hover { background: var(--selected); }
.settings-item.active { background: #087ff5; color: #fff; }
.settings-icon, .settings-hero-icon { display: flex; align-items: center; justify-content: center; color: #fff; box-shadow: inset 0 0 0 1px #ffffff24; }
.settings-icon svg, .settings-hero-icon svg { width: 70%; height: 70%; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.settings-icon { width: 23px; height: 23px; border-radius: 5px; font-size: 18px; flex-shrink: 0; }
.settings-sidebar-about { margin-top: auto; padding: 16px 8px 0; display: flex; flex-direction: column; gap: 4px; font-size: 11px; }
.settings-sidebar-about span { font-size: 10px; color: var(--muted); }
.settings-no-results { padding: 0 8px; }
.settings-detail { padding: 20px 22px; background: var(--surface); }
.settings-heading { text-align: center; margin: 0 0 18px; }
.settings-hero-icon { width: 44px; height: 44px; border-radius: 11px; margin: 0 auto 10px; font-size: 32px; }
.settings-heading h2 { font-size: 20px; letter-spacing: -.4px; margin: 0; }
.settings-heading .help { line-height: 1.45; max-width: 320px; margin: 6px auto 0; }
.settings-group { display: block; width: 100%; padding: 14px; margin: 0 0 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--footer); }
.settings-group .help { line-height: 1.5; }
.settings-group > .toggle-row:not(:first-child) { padding-top: 12px; border-top: 1px solid var(--line); margin-top: 12px; }
.settings .toggle-row { justify-content: space-between; margin: 0; min-height: 24px; }
.settings .toggle-row > input:first-child { order: 1; }
.settings input[type=checkbox] { appearance: none; position: relative; width: 30px; height: 18px; flex: 0 0 30px; border: 0; border-radius: 12px; padding: 0; background: var(--border); cursor: pointer; }
.settings input[type=checkbox]::after { content: ''; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: white; box-shadow: 0 1px 2px #0003; }
.settings input[type=checkbox]:checked { background: #087ff5; }
.settings input[type=checkbox]:checked::after { left: 14px; }
.settings input[type=checkbox]:disabled { opacity: .5; cursor: default; }
.settings .setting-row input[type=checkbox] { width: 30px; height: 18px; }
.settings-link { display: flex; align-items: center; justify-content: space-between; text-align: left; font-size: 12px; }
.settings-link > span:last-child { color: var(--muted); font-size: 20px; line-height: 16px; }
.settings-link:hover { background: var(--selected); }
.settings .theme-options { gap: 8px; margin-bottom: 0; }
.settings .theme-option { padding: 8px; }
.settings .theme-preview { height: 38px; }
.settings .system-preview { border-right-width: 35px; }
.update-status { margin: 10px 0 !important; }
.settings progress { display: block; width: 100%; margin: 10px 0; accent-color: #087ff5; }
@media (max-width: 560px) { .settings-layout { grid-template-columns: 155px minmax(0, 1fr); } .settings-detail { padding: 16px 12px; } .settings-item { padding-inline: 4px; font-size: 11px; } }
.setting-row, .setting-actions { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
.setting-row input[type=checkbox] { width: 30px; height: 18px; accent-color: var(--accent); flex-shrink: 0; }
.setting-actions { margin-top: 14px; }
.theme-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 18px 0; }
.theme-option { display: flex; flex-direction: column; gap: 9px; align-items: center; border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-size: 12px; }
.theme-option.active { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
.theme-preview { display: block; width: 100%; height: 48px; border: 1px solid #788396; border-radius: 5px; }
.light-preview { background: #f7f9fc; box-shadow: inset 0 -12px #e3e9f2; }
.dark-preview { background: #25282e; box-shadow: inset 0 -12px #3b424f; }
.system-preview { background: #f7f9fc; border-right: 70px solid #25282e; }
.danger-button { font-size: 11px; color: var(--error-ink); border: 1px solid var(--border); border-radius: 5px; padding: 6px 10px; }
.result-region { display: flex; flex: 1; min-height: 0; }
.result-region .results { min-width: 0; }
.clipboard-preview { flex: 0 0 40%; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; margin: 0 12px 10px 0; padding: 10px; border: 1px solid var(--line); border-radius: 6px; font: 11px/1.5 ui-monospace, monospace; color: var(--ink); }
.usage-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 16px 0; }
.usage-stats > div { border: 1px solid var(--line); border-radius: 7px; padding: 10px; display: flex; flex-direction: column; gap: 4px; }
.usage-stats strong { font-size: 22px; font-weight: 600; }
.usage-stats span { color: var(--muted); font-size: 11px; }
.results, .dialog-body { scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
.package-logo { background: #f5f6f8; border-radius: 8px; padding: 3px; }
.package-badge { flex: 0 0 auto; color: var(--muted); font-size: 10px; border: 1px solid var(--line); padding: 3px 7px; border-radius: 5px; }
.package-heading { display: flex; align-items: center; gap: 14px; }
.package-heading img, .item-icon img { object-fit: contain; }
.package-description { font-size: 14px; line-height: 1.6; }
.package-output { max-height: 140px; overflow: auto; padding: 12px; background: var(--field); border: 1px solid var(--line); border-radius: 8px; font-size: 11px; white-space: pre-wrap; overflow-wrap: anywhere; }
.setup-command { display: flex; align-items: center; justify-content: space-between; padding: 12px; background: var(--field); border: 1px solid var(--line); border-radius: 8px; margin: 12px 0; }
</style>
